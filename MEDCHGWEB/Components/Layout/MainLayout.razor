<MEDCHGWEB.Components.Pages.CommomModal.DeleteModal OnCloseModal="@CloseModal" @ref="DeleteHospitalModal" HeaderText="Delete Hosptial?" BodyHeaderText="Deleting this hospital will loose all its progress. Are you sure?" OnDeleteConfirmed="() => DeleteHospital(currentUrl)"></MEDCHGWEB.Components.Pages.CommomModal.DeleteModal>
<MEDCHGWEB.Components.Pages.CommomModal.DeleteModal OnCloseModal="@CloseModal" @ref="DeleteBuildingModal" HeaderText="Delete Building?" BodyHeaderText="Deleting this building will loose all its progress. Are you sure?" OnDeleteConfirmed="() => DeleteBuilding(currentUrl)"></MEDCHGWEB.Components.Pages.CommomModal.DeleteModal>

@code
{
    private string? currentUrl;
    // [CascadingParameter]
    // private HttpContext HttpContext { get; set; } = default!;
    private MEDCHGWEB.Components.Pages.CommomModal.DeleteModal DeleteHospitalModal;
    private MEDCHGWEB.Components.Pages.CommomModal.DeleteModal DeleteBuildingModal;
    public int CurrentHospitalId { get; set; }
    private CurrentUserModel? currentUser;
    public string? userRole { get; set; }
    //--------------Properties and methods of Modal---------------
    public string ModelHeading { get; set; }
    public string ModelDescription { get; set; }
    public string ModalClass = "";
    public bool ShowBackdrop = false;
    public string ModalDisplay = "none;";
    public bool ModalOpt;
    public bool HideButton;
    private HubConnection notificationHub;
    private ElementReference signOutButton;
    bool showDeleteModal = false;
    bool showBuildingDeleteModal = false;
    private string CurrentUri;
    protected override void OnInitialized()
    {
        CurrentUri = Navigation.Uri;
        stateService.YourEvent += HandleYourEvent;
        currentUrl = Navigation.ToBaseRelativePath(Navigation.Uri);
        Navigation.LocationChanged += OnLocationChanged;
    }
    async Task OpenModal(bool opt, int i)
    {
        ModalDisplay = "block;";
        await Task.Delay(100);
        if (opt)
        {
            ModalOpt = true;
            switch (i)
            {
                case 1:
                    ModelHeading = "Delete User?";
                    ModelDescription = "Deleting this user will loose all its progress. Are you sure?";
                    HideButton = true;
                    break;
                case 2:
                    ModelHeading = "Alert";
                    ModelDescription = "This user cannot be deleted because their status is active.";
                    HideButton = false;
                    break;
                default:
                    ModelHeading = "Alert";
                    ModelDescription = "This user cannot be deleted because the patient is assigned to this user.";
                    HideButton = false;
                    break;
            }
        }
        else
        {
            ModalOpt = false;
        }
        ModalClass = "show";
        ShowBackdrop = true;
        StateHasChanged();
    }
    public async Task CloseModal()
    {
        ModalClass = "";
        await Task.Delay(250);
        ModalDisplay = "none";
        ShowBackdrop = false;
        StateHasChanged();
    }
    public void ShowDeleteModal()
    {
        DeleteHospitalModal.OpenModal(true);
    }
    public void ShowBuildingDeleteModal()
    {
        DeleteBuildingModal.OpenModal(true);
    }
    private async Task Delete(string id)
    {
        var Id = Convert.ToInt64(string.Concat(id.Where(char.IsDigit)));
        var GetUser = await httpclient.PostAsync($"api/User/GetById{Id}", null);
        if (GetUser.IsSuccessStatusCode)
        {
            var usercontent = await GetUser.Content.ReadAsStringAsync();
            dynamic jsonObject = JsonConvert.DeserializeObject(usercontent);
            var check = new User()
                {
                    IsActive = jsonObject.isActive,
                };
            if (check.IsActive is 1)
            {
                await OpenModal(true, 2);
            }
            else
            {
                var User = await httpclient.PostAsJsonAsync($"api/User/DeleteUser", Id);
                await CloseModal();
                if (User.IsSuccessStatusCode)
                {
                    await JSRuntime.InvokeVoidAsync("blazorGoBack");
                }
                else
                {
                    // Handle unsuccessful login (Bad Request or other errors)
                    // Read the content of the response
                    var content = await User.Content.ReadAsStringAsync();
                    // Log or handle the error message as needed
                    Console.WriteLine("Error: " + content);
                }
            }
        }
        else
        {
            var content = await GetUser.Content.ReadAsStringAsync();
            Console.WriteLine("Error: " + content);
        }
    }

    private void HandleYourEvent()
    {
        OnInitializedAsync();
        // Handle the event
    }
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = Navigation.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }
    public void Dispose()
    {
        stateService.YourEvent -= HandleYourEvent;
        Navigation.LocationChanged -= OnLocationChanged;
        if (notificationHub != null)
        {
            notificationHub.StopAsync().ConfigureAwait(false);
            notificationHub.DisposeAsync().ConfigureAwait(false);
        }
    }
    public async Task DeleteHospital(string id)
    {
        CurrentHospitalId = Convert.ToInt32(string.Concat(id.Where(char.IsDigit)));
        var resp = await httpclient.PostAsJsonAsync<bool>($"api/Hospital/DeleteHospital/{CurrentHospitalId}", false);
        if (resp.IsSuccessStatusCode)
        {
            Navigation.NavigateTo("GetAllProvider");
        }
        else
        {
            var err = resp.Content.ReadAsStringAsync();
        }
    }
    public async Task DeleteBuilding(string id)
    {
        var BuildingId = Convert.ToInt32(string.Concat(id.Where(char.IsDigit)));
        var resp = await httpclient.PostAsJsonAsync<bool>($"api/Building/DeleteBuilding/{BuildingId}", false);
        if (resp.IsSuccessStatusCode)
        {
            Navigation.NavigateTo("GetAllProvider");
        }
        else
        {
            var err = resp.Content.ReadAsStringAsync();
        }
    }
    private string _centerName;
    [Parameter]
    public string CenterName
    {
        get
        {
            return _centerName;
        }
        set
        {
            _centerName = value;
        }
    }
    private void NavigateToAllProvider()
    {
        Navigation.NavigateTo("/GetAllProvider");
    }
    private void NavigateToHospitalPatient()
    {
        Navigation.NavigateTo("/HospitalPatient");
    }
    private async Task GoBack(int val)
    {
        if (val == 0)
        {
            CenterName = null;
        }
        else
        {
            stateService.MyVariable = null;
        }
        await JSRuntime.InvokeVoidAsync("blazorGoBack");
    }
    private async Task ChangeVariableAndNavigate(int i)
    {
        switch (i)
        {
            case 1:
                Navigation.NavigateTo($"/EditAdminUser/{currentUser.Id}");
                break;
            case 2:
                Navigation.NavigateTo($"/ViewUser");
                break;
            case 3:
                Navigation.NavigateTo($"/VisitHistory");
                break;
            case 4:
                Navigation.NavigateTo($"/Admin/Billing");
                break;
            case 5:
                var BuildingId = await sessionStorage.GetItemAsync<string>("BuildingId");
                Navigation.NavigateTo($"/PatientFloor/{BuildingId}");
                break;
            case 6:
                var HospitalId = await sessionStorage.GetItemAsync<string>("HospitalId");
                Navigation.NavigateTo($"/BuildingPatient/{HospitalId}");
                break;
            default:
                Navigation.NavigateTo($"/UserEdit/{currentUser.Id}");
                break;

        }
    }
    private async Task ToggleDropdown()
    {
        await JS.InvokeVoidAsync("myFunction");
    }
    protected override async Task OnInitializedAsync()
    {
        Console.WriteLine("Start Time Of Main Layout:-" + DateTime.Now);
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity.IsAuthenticated)
        {
            var httpContext = HttpContextAccessor.HttpContext;
            //var token = stateService.AccessToken;
            if (httpContext != null)
            {
                var token = httpContext.Request.Cookies["jwtToken"];
                httpclient.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            }
            currentUser = user.GetUserInfo();
            userRole = currentUser.UserRole;
            if (currentUser.ProviderId is null)
            {
                CenterName = stateService.AdminVariable;
            }
            else
            {
                CenterName = currentUser.ProviderDisplayName;
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("preventXSSPolicy");
        if (firstRender)
        {
            notificationHub = new HubConnectionBuilder().WithUrl(Navigation.ToAbsoluteUri("/NotificationHub"))
            .WithAutomaticReconnect()
            .Build();
            notificationHub.On<List<string>>("ReceiveNotification", async (userIds) =>
            {
                if (userIds.Contains(currentUser.UserId))
                {
                    // Logout
                    await JS.InvokeVoidAsync("clickElement", "signOutButton");
                }
            });

            await notificationHub.StartAsync();
        }
    }
}

