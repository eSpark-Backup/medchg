@inherits LayoutComponentBase
@inject IJSRuntime JSRuntime
@using System.Security.Claims
@using MEDCHGWEB.Extensions
@using MEDCHGClassLibrary.DbContext
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.AspNetCore.Identity
@using System.Text.RegularExpressions
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject SignInManager<ApplicationUser> SignInManager
@inject NavigationManager Navigation
@inject IHttpContextAccessor HttpContextAccessor
@implements IDisposable
@attribute [Authorize]
<div class="page">
    <main>
        <div class="container-fluid">
            <div class="row bgteal p-2 position-fixed w-100 z-3">
                <div class="col-6 ps-0 d-flex align-items-center">
                    @if (currentUser != null)
                    {
                        @if (currentUser?.UserRole == "Superadmin" || currentUser?.UserRole == "Editor Access")
                        {
                            <a href="@("/GetAllProvider")" name="AdminDash" @onclick="NavigateToAllProvider">
                                <img src="/images/logo_icon.png" style="width:2rem" />
                                <img src="/images/property1=white.png" style="width:6rem" />
                            </a>
                        }
                        else
                        {
                            <a href="@("/HospitalPatient")" name="UserDash" @onclick="NavigateToHospitalPatient">
                                <img src="/images/logo_icon.png" style="width:2rem" />
                                <img src="/images/property1=white.png" style="width:6rem" />
                            </a>
                        }
                    }
                </div>
                <div class="col-6 pe-0">
                    <div class="row justify-content-end align-items-baseline">
                        <div class="col-auto DashboardAnchor">
                            @if (currentUser != null)
                            {
                                @if (currentUser?.UserRole == "Superadmin" || currentUser?.UserRole == "Editor Access")
                                {
                                    <a href="@("/GetAllProvider")" class="text-white me-2 responsive-nav" @onclick="NavigateToAllProvider">Go to dashboard</a>
                                }
                                else
                                {
                                    <a href="@("/HospitalPatient")" class="text-white me-2 responsive-nav" @onclick="NavigateToHospitalPatient">Go to dashboard</a>
                                }
                            }
                        </div>
                        <div class="col-auto pe-1">
                            <img class="rounded-circle shadow dropbtn" data-test-id="UserImage" alt="avatar2" width="50" height="50" src="@currentUser?.ImgUrl" @onclick="ToggleDropdown" style="cursor:pointer" />
                        </div>

                        <div class="col-auto ps-0">
                            @if (currentUser != null)
                            {
                                <div class="col-auto dropbtn displayname" data-test-id="UserNameText" @onclick="ToggleDropdown" style="cursor:pointer;height: 39px;">
                                    <p class="displayname dropbtn" style="color:white;">@currentUser.FullName</p>
                                </div>
                                <div id="myDropdown" class="dropdown-content justify-content-end">
                                    <div class="col-12 text-center mt-2">
                                        <img class="rounded-circle shadow align-items-center" alt="avatar2" width="50" height="50" src="@currentUser?.ImgUrl" />
                                    </div>
                                    <div class="col-12 text-center">
                                        <p class="px-4 d-flex flex-column-reverse">@currentUser?.FullName</p>
                                    </div>
                                    <div class="col-12 text-center">
                                        <p class="px-4 d-flex flex-column-reverse">@currentUser?.Email</p>
                                    </div>
                                    <hr />
                                    @if (currentUser?.UserRole == "Doctor" || currentUser?.UserRole == "User")
                                    {
                                        if (!currentUrl!.Contains("UserEdit"))
                                        {
                                            <div class="col-12" data-test-id="Account Settings" @onclick="()=>ChangeVariableAndNavigate(0)" style="cursor:pointer;">
                                                <div class="row navhover m-0" style="margin-bottom:4px!important">
