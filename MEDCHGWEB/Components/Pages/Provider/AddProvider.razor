@page "/AddProvider"
@attribute [Authorize(Roles = "Superadmin")]
<div class="container border rounded-3 border-2">
    <div class="row border justify-content-center p-4" style="background-color:#E9EAF7">
        <div class="col-lg-6 border rounded" style="background-color:#F5F6FF">
            <div class="row border bg-white">
                <h5 class="text-center">Details</h5>
            </div>
            <div class="row border bg-Indigo-20 justify-content-center">
                <div class="col-lg-8">
                    <EditForm Model="@Model" OnValidSubmit="@Submit" FormName="Provider">
                        <DataAnnotationsValidator />
                        <ValidationSummary />
                        <div class="form-group">
                            <label for="exampleInputName" class="mt-3">Name:</label>
                            <InputText @bind-Value="Model!.Name" class="form-control specialAllow" type="text" placeholder="CRITICALCARE" />
                        </div>
                        <div class="form-group">
                            <label for="exampleInputName" class="mt-3">Display Name:</label>
                            <InputText @bind-Value="Model.DisplayName" class="form-control specialAllow" type="text" placeholder="DFW CRITICAL CARE GROUP LLC" />
                        </div>
                        <br />
                        <div class="row">
                            <div class="col-2"></div>
                            <button type="submit" class="btn btn-primary col-8">Create</button>
                        </div>
                        <p style="color: red;">@ErrorMessage</p>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
</div>
<br />
<br />
<br />
@code
{
    [SupplyParameterFromForm]
    public ProviderDTO? Model { get; set; }
    public string ErrorMessage { get; set; }
    protected override void OnInitialized() => Model ??= new();
    private CurrentUserModel? currentUser;
    public async Task Submit()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity!.IsAuthenticated)
        {
            currentUser = user.GetUserInfo();
        }
        var GetProvidersresponse = await httpclient.GetFromJsonAsync<List<Provider>>($"api/Provider/GetAllProviders");
        var CompareProviderName = GetProvidersresponse.Where(x => x.Name == Model.Name.Replace(" ", "").ToLower() && x.IsActive !=3);
        if (CompareProviderName.Count() > 0)
        {
            ErrorMessage = "Please Enter Different Provider Name!";
        }
        else
        {
            ErrorMessage = "";
            stateService.PreviousURL = Navigation.Uri;
            Model!.Name.Replace(" ", "").ToLower();
            Model.CreatedAndUpdatedById = Convert.ToInt32(currentUser.Id);
            var Provider = await httpclient.PostAsJsonAsync("api/Provider/Add-Provider", Model);
            if (Provider.IsSuccessStatusCode)
            {
                stateService.AdminVariable = Model!.DisplayName;
                stateService.InvokeYourEvent();
                var response = await Provider.Content.ReadFromJsonAsync<Provider>();
                Navigation.NavigateTo($"/GetAllProvider");
            }
            else
            {
                // Handle unsuccessful login (Bad Request or other errors)
                // Read the content of the response
                var content = await Provider.Content.ReadAsStringAsync();
                // Log or handle the error message as needed
                Console.WriteLine("Error: " + content);
            }
        }
    }

}
