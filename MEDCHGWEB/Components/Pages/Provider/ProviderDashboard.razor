    private async Task Sort(int num)
    {
        if (sortedColumn == num)
        {
            isAscending = !isAscending;
        }
        else
        {
            sortedColumn = num;
            isAscending = true;
        }
        switch (num)
        {
            case 0:
                allUsers = isAscending ? allUsers.OrderBy(x => x.UserName).ToList() : allUsers.OrderByDescending(x => x.UserName).ToList();
                break;
            case 1:
                allHospitals = isAscending ? allHospitals.OrderBy(x => x.HospitalName).ToList() : allHospitals.OrderByDescending(x => x.HospitalName).ToList();
                break;
            case 2:
                allDiagnosticCodes = isAscending ? allDiagnosticCodes.OrderBy(x => x.DiagnosticCodeName).ToList() : allDiagnosticCodes.OrderByDescending(x => x.DiagnosticCodeName).ToList();
                break;
            case 3:
                allChargeCodes = isAscending ? allChargeCodes.OrderBy(x => x.ChargeCodeName).ToList() : allChargeCodes.OrderByDescending(x => x.ChargeCodeName).ToList();
                break;
            default:
                break;
        }
        StateHasChanged();
    }

