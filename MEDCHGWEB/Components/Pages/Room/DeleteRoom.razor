<!-- Modal -->
<div class="modal fade @Class" tabindex="-1" role="dialog" style="display:@Display" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="z-index:1055">
        <div class="modal-content" style="background-color:#E9EAF7">
            <div class="container p-3">
                <div class="row justify-content-center">
                    <div class="col-3">
                        <svg width="77" height="76" viewBox="0 0 77 76" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <rect x="3.5" y="3" width="70" height="70" rx="35" fill="#AAAAAA" fill-opacity="0.3" />
                            <rect x="3.5" y="3" width="70" height="70" rx="35" stroke="#E9EEEF" stroke-width="6" />
                            <path fill-rule="evenodd" clip-rule="evenodd" d="M33.6094 18.6763C35.7514 14.8683 41.231 14.8683 43.3702 18.6763L58.9942 46.4523C61.0942 50.1875 58.3978 54.7963 54.1166 54.7963H22.8658C18.5818 54.7963 15.8854 50.1875 17.9854 46.4523L33.6094 18.6763ZM41.2898 46.3991C41.2898 47.1417 40.9948 47.8539 40.4697 48.379C39.9446 48.9041 39.2324 49.1991 38.4898 49.1991C37.7472 49.1991 37.035 48.9041 36.5099 48.379C35.9848 47.8539 35.6898 47.1417 35.6898 46.3991C35.6898 45.6565 35.9848 44.9443 36.5099 44.4192C37.035 43.8941 37.7472 43.5991 38.4898 43.5991C39.2324 43.5991 39.9446 43.8941 40.4697 44.4192C40.9948 44.9443 41.2898 45.6565 41.2898 46.3991ZM38.4898 23.9991C37.7472 23.9991 37.035 24.2941 36.5099 24.8192C35.9848 25.3443 35.6898 26.0565 35.6898 26.7991V35.1991C35.6898 35.9417 35.9848 36.6539 36.5099 37.179C37.035 37.7041 37.7472 37.9991 38.4898 37.9991C39.2324 37.9991 39.9446 37.7041 40.4697 37.179C40.9948 36.6539 41.2898 35.9417 41.2898 35.1991V26.7991C41.2898 26.0565 40.9948 25.3443 40.4697 24.8192C39.9446 24.2941 39.2324 23.9991 38.4898 23.9991Z" fill="#AAAAAA" />
                        </svg>
                    </div>
                </div>
                <div class="row justify-content-center mt-2">
                    <div class="col-6">
                        <h5 class="text-center">Delete Room @Name</h5>
                    </div>
                </div>
                <div class="row justify-content-center">
                    <div class="col-8 text-center">
                        <h6>Are you sure you want to delete Room @Name?</h6>
                    </div>
                </div>
                <div class="row mt-2">
                    <div class="col-6 text-center">
                        <button type="button" class="btn btn-outline-primary col-5" @onclick="CloseModal">
                            Cancel
                            <i class="fas fa-close"></i>
                        </button>
                    </div>
                    <div class="col-6 text-center">
                        <button type="button" class="btn btn-primary col-6" @onclick="DeleteItem" disabled="@IsDeleteButtonDisabled">
                            Delete
                            <svg width="14" height="16" viewBox="0 0 14 16" fill="none" xmlns="http://www.w3.org/2000/svg" style="margin-bottom:3px;">
                                <path fill-rule="evenodd" clip-rule="evenodd" d="M6 0C5.81434 9.91486e-05 5.63237 0.0518831 5.47447 0.149552C5.31658 0.247222 5.18899 0.386919 5.106 0.553L4.382 2H1C0.734784 2 0.48043 2.10536 0.292893 2.29289C0.105357 2.48043 0 2.73478 0 3C0 3.26522 0.105357 3.51957 0.292893 3.70711C0.48043 3.89464 0.734784 4 1 4V14C1 14.5304 1.21071 15.0391 1.58579 15.4142C1.96086 15.7893 2.46957 16 3 16H11C11.5304 16 12.0391 15.7893 12.4142 15.4142C12.7893 15.0391 13 14.5304 13 14V4C13.2652 4 13.5196 3.89464 13.7071 3.70711C13.8946 3.51957 14 3.26522 14 3C14 2.73478 13.8946 2.48043 13.7071 2.29289C13.5196 2.10536 13.2652 2 13 2H9.618L8.894 0.553C8.81101 0.386919 8.68342 0.247222 8.52553 0.149552C8.36763 0.0518831 8.18566 9.91486e-05 8 0H6ZM4 6C4 5.73478 4.10536 5.48043 4.29289 5.29289C4.48043 5.10536 4.73478 5 5 5C5.26522 5 5.51957 5.10536 5.70711 5.29289C5.89464 5.48043 6 5.73478 6 6V12C6 12.2652 5.89464 12.5196 5.70711 12.7071C5.51957 12.8946 5.26522 13 5 13C4.73478 13 4.48043 12.8946 4.29289 12.7071C4.10536 12.5196 4 12.2652 4 12V6ZM9 5C8.73478 5 8.48043 5.10536 8.29289 5.29289C8.10536 5.48043 8 5.73478 8 6V12C8 12.2652 8.10536 12.5196 8.29289 12.7071C8.48043 12.8946 8.73478 13 9 13C9.26522 13 9.51957 12.8946 9.70711 12.7071C9.89464 12.5196 10 12.2652 10 12V6C10 5.73478 9.89464 5.48043 9.70711 5.29289C9.51957 5.10536 9.26522 5 9 5Z" fill="white" />
                            </svg>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    @if (Backdrop)
    {
        <div class="modal-backdrop fade show" data-dismiss="modal" @onclick="() => CloseModal()"></div>
    }
</div>


@code {
    public string Display { get; set; }
    public string Class { get; set; }
    public bool IsDeleteButtonDisabled { get; set; } = false;
    public bool Backdrop { get; set; }
    [Parameter]
    public EventCallback<bool> OnCloseModal { get; set; }

    [Parameter]
    public EventCallback OnDeleteConfirmed { get; set; }

    [Parameter]
    public string? Name { get; set; }
    public async Task OpenModal(bool opt)
    {
        Display = "block;";
        await Task.Delay(100);
        Class = "show";
        Backdrop = true;
        StateHasChanged();
    }


    public async Task CloseModal()
    {
        Class = "";
        await Task.Delay(250);
        Display = "none";
        Backdrop = false;
        await OnCloseModal.InvokeAsync();
        StateHasChanged();
    }

    private async Task DeleteItem()
    {
        IsDeleteButtonDisabled = true;
        await OnDeleteConfirmed.InvokeAsync();
        await CloseModal();
    }

}
