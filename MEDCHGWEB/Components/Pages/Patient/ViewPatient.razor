                    </div>
                </div>
                @if (patient != null)
                    @foreach (var item in VisitHistories?.Where(x => x.CodeSubType == "Manual" && x.CodeType == "Charge Code"))
                    {
                        <div class="row mt-3 justify-content-center">
                            <div class="col-lg-6 col-xsm-10 bg-white border border-2 rounded-2">
                                <div class="row p-1">
                                    <div class="col-9">
