    Floor? selectedFloorDesc { get; set; }
    Room? selectedRoomDesc { get; set; }

    Patient? patient { get; set; } = new();
    Provider? providers { get; set; } = new();
    PatientInfoVm? GlobalResponse = new();

    int delDiagId = 0;
    int delChargeId = 0;
    int delTempCodeId = 0;
    int perPage = 10;

    List<Building>? buildings;
    List<Floor>? floors;
    List<Room>? rooms;
    List<Hospital?>? AllHospitals = new();
    List<PatientVisitHistoryDetailList?>? VisitHistories = new();
    List<Building?>? AllBuildings = new();
    List<Floor?>? AllFloors = new();
    List<PatientInfoVm?>? PatientInfoVmList = new();
    List<Room?>? AllRooms = new();
    PatientVisitHistory visitHistory = new();
    PatientVisitHistoryDetailList Location = new();

    private EditContext? editContext;
    private CurrentUserModel? currentUser;
    private bool isInitialized = false;
    protected override async Task OnInitializedAsync()
    {
        if (!isInitialized)
        {
            isInitialized = true;
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity!.IsAuthenticated)
            {
                currentUser = user.GetUserInfo();
            }
            editContext = new EditContext(patient);
            if (Int32.TryParse(patientId, out int id))
            {
                try
                {
                    var response = await httpclient.GetFromJsonAsync<PatientInfoVm>($"api/Patient/PatientInformation/?pId={Convert.ToInt32(patientId)}");
                    GlobalResponse = response;
                    if (response != null)
                    {
                        patient.Id = response.Id!.Value;
                        patient.Name = response.FullName;
                        patient.Salutation = string.IsNullOrWhiteSpace(response.Salutation) ? "N/A" : response.Salutation;
                        patient.FirstName = response.FirstName;
                        patient.MiddleName = response.MiddleName;
                        patient.LastName = response.LastName;
                        patient.MRN = response.MRN;
                        patient.CreatedAt = response.CreatedAt.Value;
                        patient.PatientVisitHistories.PatientCensusStatus = (CensusStatus)response.CensusStatus;
                        patient.PatientVisitHistories.UserId = response.UserId;
                        patient.PatientVisitHistories.Id = response.PatientVisitsId.Value;
                        patient.PatientAddmissionDateTime = response.AdmissionDate is null ? TimeHelper.GetTexasTime() : response.AdmissionDate;
                        patient.PatientVisitHistories.PatientId = patient.Id;
                        Location.HospitalId = response.HospitalId.Value;
                        Location.BuildingId = response.BuildingId.Value;
                        Location.FloorId = response.FloorId.Value;
                        Location.RoomId = response.RoomId.Value;
                        patient.PatientVisitHistories.PatientVisitHistoryDetailLists.Add(Location);
                        patient.PatientVisitHistories.CreatedAt = response.AdmissionDate is null ? TimeHelper.GetTexasTime() : response.AdmissionDate.Value;
                        patient.Gender = ((Gender)response.Gender);
                        Age = response.Age;
                        DateofBirth = response.DateOfBirth;
                        PractName = response.Practitioner;
                        patient.PatientVisitHistories.Id = response.PatientVisitHistoryId.Value;
                        if (response.Visits != null)
                        {
                            foreach (var item in response.Visits.OrderByDescending(x => x.CreatedAt))
                            {
                                var row = new ResponseModel();
                                row.VisitHistoryId = item.PatientVisitHistoryId;
                                row.UserId = response.UserId.Value;
                                row.Id = item.PatientVisitHistoryDetailId;
                                row.UserName = item.Username;
                                row.Description = item.CodeDescription;
                                row.Code = item.CodeName;
                                row.Type = item.Type;
                                // Convert UTC to CDT
                                row.CreatedAt = item.CreatedAt.Value;
                                row.CurrentlyAdded = false;
                                Codes.Add(row);
                            }
                        }
                        AllHospitals = await httpclient.GetFromJsonAsync<List<Hospital>>($"api/Hospital/GetAllHospitals");
                        AllBuildings = await httpclient.GetFromJsonAsync<List<Building>>($"api/Building/GetAllBuildings");
                        AllFloors = await httpclient.GetFromJsonAsync<List<Floor>>($"api/Floor/GetAllFloors");
                        AllRooms = await httpclient.GetFromJsonAsync<List<Room>>($"api/Room/GetAllRooms");
                        hospital = AllHospitals.Where(x => x.Id == response.HospitalId).FirstOrDefault();
                        hospital.Buildings = AllBuildings.Where(x => x.HospitalId == response.HospitalId).ToList();
                        building = AllBuildings.Where(x => x.Id == response.BuildingId).FirstOrDefault();
                        floors = new List<Floor>();
                        floors = AllFloors.Where(x => x.BuildingId == building.Id).OrderBy(x => x.Id).ToList();
                        floorNo = response.FloorName;
                        roomNo = response.RoomName;
                        var respProvdiag = await httpclient.GetFromJsonAsync<List<DiagnosticCode>>($"api/Provider/GetAllDiagnosticCodesByProviderId{currentUser.ProviderId}");
                        var UsersDiagnosticCodesresponse = await httpclient.GetFromJsonAsync<List<UsersDiagnosticCode>>($"api/User/GetUsersDiagnosticCodeById{currentUser.Id}");
                        foreach (var DiagnosticCode in respProvdiag)
                        {
                            var usersDiagnosticCode = UsersDiagnosticCodesresponse.FirstOrDefault(u => u.DiagnosticCodeId == DiagnosticCode.Id);
                            if (usersDiagnosticCode != null)
                            {
                                DiagnosticCode.IsFavourite = usersDiagnosticCode.IsFavourite;
                            }
                        }
                        if (respProvdiag.Count > 0)
                        {
                            providers.DiagnosticCode = respProvdiag.OrderByDescending(x=>x.IsFavourite).ToList();
                        }
                        else
                        {
                            var t = "There's No Diagnostic Code Created!";
                        }
                        var respProvusr = await httpclient.GetFromJsonAsync<List<User>>($"api/Provider/GetAllUsersByProviderId{currentUser.ProviderId}");
                        if (respProvusr.Count > 0)
                        {
                            providers.User = respProvusr.ToList();
                        }
                        else
                        {
                            var t = "There's No User Created!";
                        }
                        var respProvchrg = await httpclient.GetFromJsonAsync<List<ChargeCode>>($"api/Provider/GetAllChargeCodesByProviderId{currentUser.ProviderId}");
                        var UsersChargeCodesresponse = await httpclient.GetFromJsonAsync<List<UsersChargeCode>>($"api/User/GetUsersChargeCodeById{currentUser.Id}");
                        foreach (var chargeCode in respProvchrg)
                        {
                            var usersChargeCode = UsersChargeCodesresponse.FirstOrDefault(u => u.ChargeCodeId == chargeCode.Id);
                            if (usersChargeCode != null)
                            {
                                chargeCode.IsFavourite = usersChargeCode.IsFavourite;
                            }
                        }
                        if (respProvchrg.Count > 0)
                        {
                            providers.ChargeCode = respProvchrg.OrderByDescending(x=>x.IsFavourite).ToList();
                        }
                        else
                        {
                            var t = "There's No Charge Code Created!";
                        }
                    }
                }
                catch (Exception ex)
                {
                    throw ex;
                }
            }
            StateHasChanged();
        }
        visitHistory.Id = patient.PatientVisitHistories.Id;
        visitHistory.PatientId = Convert.ToInt32(patientId);
        visitHistory.CreatedById = Convert.ToInt32(currentUser.Id);
        visitHistory.Device = "Web";
        visitHistory.PatientCensusStatus = CensusStatus.ADMITTED;
        visitHistory.ProviderId = Convert.ToInt32(currentUser.ProviderId);
    }

    private void CheckboxChanged(ChangeEventArgs e)
    {
        var value = e.Value;
    }
    //--------------Properties and methods of Modal---------------
    async Task OpenModal(bool opt, int i)
    {
        ErrorMessage = "";
        if (selectedFloorDesc is not null)
        {
            if (selectedRoomDesc is not null)
            {
                ModalDisplay = "block;";
                await Task.Delay(100);
                if (opt)
                {
                    ModalOpt = true;
                    switch (i)
                    {
                        case 1:
                            ModelHeading = "Relocate Patient?";
                            ModelDescription = "Are you sure you want to relocate this patient?";
                            TocheckMethod = i;
                            break;
                        default:
                            break;

                    }
                }
                else
                {
                    ModalOpt = false;
                }
                ModalClass = "show";
                ShowBackdrop = true;
                StateHasChanged();
            }
            else
            {
                ErrorMessage = "Please select room.";
                await CloseModal();
            }
        }
        else
        {
            if (selectedBuildingDesc is null)
            {
                ErrorMessage = "Please select building, floor, and room";
            }
            else
            {
                ErrorMessage = "Please select floor and room!";
            }
            await CloseModal();
        }
    }
    async Task CloseModal()
    {
        if (Deletecensusstatus.HeaderText is "Close census status?")
        {
            patient.PatientVisitHistories.PatientCensusStatus = CensusStatus.ADMITTED;
            PatientCensusStatus = true;
            StateHasChanged();
        }
        ModalClass = "";
        await Task.Delay(150);
        ModalDisplay = "none";
        ShowBackdrop = false;
        StateHasChanged();
    }
    async Task CheckMethod(int Tocheck)
    {
        switch (Tocheck)
        {
            case 1:
                await Submit();
                break;
            default:
                break;
        }
    }

    private void SelectedOption(string e)
    {
        selectedPageSize = e;
    }
    private void ShowBuildingModal()
    {
        BuildingModal.OpenModal(true);
    }

    private void ShowFloorModal()
    {
        FloorModal.OpenModal(true);
    }

    private void ShowRoomModal()
    {
        PatientVisitModal.OpenModal(true);
    }

    private void OnSaveBuildingModal(Building selectedBuilding)
    {
        floors = new List<Floor>();
        selectedBuildingDesc = selectedBuilding;
        floors = AllFloors?.Where(x => x.BuildingId == selectedBuilding.Id).OrderBy(x => x.Id).ToList()!;
        Location!.BuildingId = selectedBuilding.Id;
        showBuildingDeleteBin = true;
        isFloorVisible = true;

    }

    private async Task OnSaveFloorModal(Floor selectedFloor)
    {
        rooms = new List<Room>();
        selectedFloorDesc = selectedFloor;
        PatientInfoVmList = await httpclient.GetFromJsonAsync<List<PatientInfoVm>>($"api/Patient/PatientInformationList");
        rooms = AllRooms?.Where(x => x.FloorId == selectedFloor.Id).ToList()!;
        Location!.FloorId = selectedFloor.Id;
        showFloorDeleteBin = true;
        isRoomVisible = true;
    }

    private void OnSaveRoomModal(Room selectedRoom)
    {
        selectedRoomDesc = selectedRoom;
        Location.RoomId = selectedRoom.Id;
        showRoomDeleteBin = true;
    }

    public async Task Submit()
    {
        ErrorMessage = "";
        if (selectedFloorDesc is not null)
        {
            if (selectedRoomDesc is not null)
            {
                ErrorMessage = "";
                visitHistory.UpdatedById = Convert.ToInt32(currentUser.Id);
                visitHistory.UpdatedAt = TimeHelper.GetTexasTime();
                visitHistory.PatientVisitHistoryDetailLists.Add(new PatientVisitHistoryDetailList
                    {
                        HospitalId = Location.HospitalId,
                        BuildingId = selectedBuildingDesc.Id,
                        FloorId = selectedFloorDesc.Id,
                        RoomId = selectedRoomDesc.Id,

                        PractitionerId = Convert.ToInt32(currentUser.Id),
                        PractitionerName = currentUser.FullName,

                        CreatedById = Convert.ToInt32(currentUser.Id),
                        Device = "WEB",
                    });
                var newItems = new PatientVisitHistoryDetailList
                    {

                        PatientVisitHistoryId = visitHistory.Id,

                        HospitalId = Location.HospitalId,
                        BuildingId = selectedBuildingDesc.Id,
                        FloorId = selectedFloorDesc.Id,
                        RoomId = selectedRoomDesc.Id,

                        PractitionerId = Convert.ToInt32(currentUser.Id),
                        PractitionerName = currentUser.FullName,

                        CreatedById = Convert.ToInt32(currentUser.Id),
                        Device = "WEB",
                    };
                var response = await httpclient.PostAsJsonAsync($"api/PatientCode/VisitHistory/AddVisitHistoryDetail", newItems);
                var responseforchange = await httpclient.GetFromJsonAsync<PatientInfoVm>($"api/Patient/PatientInformation/?pId={Convert.ToInt32(patientId)}");
                if (response.IsSuccessStatusCode)
                {
                    building = AllBuildings.Where(x => x.Id == responseforchange.BuildingId).FirstOrDefault();
                    floors = new List<Floor>();
                    floors = AllFloors.Where(x => x.BuildingId == building.Id).ToList();
                    floorNo = responseforchange.FloorName;
                    roomNo = responseforchange.RoomName;
                    selectedBuildingDesc = null;
                    selectedFloorDesc = null;
                    selectedRoomDesc = null;
                    StateHasChanged();
                    await CloseModal();
                }
                else
                {
                    var t = response.Content.ReadAsStringAsync().Result;
                }
            }
            else
            {
                ErrorMessage = "Please select room.";
                await CloseModal();
            }
        }
        else
        {
            ErrorMessage = "Please select floor and room.";
            await CloseModal();
        }
    }

    private void ShowDiagnosticModal()
    {
        DiagnosticCodeModal.OpenModal(true);
    }

    private void ShowChargeModal()
    {
        ChargeCodeCodeModal.OpenModal(true);
    }

    private async Task OnSaveDiagnosticModal(DiagnosticCode selectedItem)
    {
        var newItems = new PatientVisitHistoryDetailList
            {

                PatientVisitHistoryId = visitHistory.Id,

                HospitalId = Location.HospitalId,
                BuildingId = Location.BuildingId,
                FloorId = Location.FloorId,
                RoomId = Location.RoomId,

                CodeName = selectedItem.DiagnosticCodeName,
                CodeDescription = selectedItem.DiagnosticCodeDescription,
                CodeType = "Diagnostic Code",

                PractitionerId = Convert.ToInt32(currentUser.Id),
                PractitionerName = currentUser.FullName,

                CreatedById = Convert.ToInt32(currentUser.Id),
                Device = "WEB",
            };
        var resp1 = await httpclient.PostAsJsonAsync<PatientVisitHistoryDetailList>($"api/PatientCode/VisitHistory/AddVisitHistoryDetail", newItems);
        if (resp1.IsSuccessStatusCode)
        {
            var visitHistoryResult = await resp1.Content.ReadFromJsonAsync<PatientVisitHistoryDetailList>();
            VisitHistories?.Add(visitHistoryResult);
            CodesObj = new();
            CodesObj.VisitHistoryId = visitHistory.Id;
            CodesObj.Code = newItems.CodeName;
            CodesObj.Description = newItems.CodeDescription;
            CodesObj.Type = newItems.CodeType;
            CodesObj.UserName = newItems.PractitionerName;
            CodesObj.UserId = newItems.PractitionerId;
            CodesObj.CurrentlyAdded = true;
            CodesObj.CreatedAt = newItems.CreatedAt;
            CodesObj.Id = visitHistoryResult.Id;
            Codes.Add(CodesObj);
        }
        else
        {
            var err = resp1.Content.ReadAsStringAsync().Result;
        }
    }

    private async Task OnSaveChargeModal(ChargeCode selectedItem)
    {
        var newItems = new PatientVisitHistoryDetailList
            {

                PatientVisitHistoryId = visitHistory.Id,

                HospitalId = Location.HospitalId,
                BuildingId = Location.BuildingId,
                FloorId = Location.FloorId,
