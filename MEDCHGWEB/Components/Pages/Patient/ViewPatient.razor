            </div>
            <div class="col-lg-5 col-xsm-6 align-content-center">
                <h3 class="m-0">
                    Visit History
                </h3>
            </div>
            <div class="col-2 border border-3 rounded-3 mt-3 mb-3 simple-patient-view">
                <form class="row p-1 g-3">
                    <div class="col-4 pt-1">
                        <h5>
                            Show
                        </h5>
                    </div>
                    <div class="col-8">
                        <div class="dropdown">
                            <button class="btn btn-secondary dropdown-toggle2 w-100 text-start" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="background-color: #f5f6ff;color: #2474b3;">
                                @((selectedPageSize == null) ? "All" : selectedPageSize)
                            </button>
                            <ul class="dropdown-menu shadow" style="min-width:7rem!important">
                                @foreach (var option in PageSizeOptions)
                                {
                                    <li class="dropdown-item" @onclick="()=>SelectedOption(option)">@option <span style="margin-left: 46px;color: green;">@((option == selectedPageSize) ? "✓" : "")</span></li>
                                }
                            </ul>
                        </div>
                    </div>
                </form>
            </div>
        </div>
        <div class="row justify-content-center pt-3 border-top">
            <div class="col-11 border border-3 rounded-3 bg-Indigo-10 p-4">
                @if (Codes != null)
                {
                    @foreach (ResponseModel? item in Codes.OrderByDescending(x => x.Id).Take(perPage))
                    {
                        @if (!string.IsNullOrWhiteSpace(item.Code))
                        {
                            <div class="row text-center m-0 border border-3 rounded-3 bg-white shadow p-1">
                                <div class="col-lg-3 col-xl-auto align-content-center">
                                    @if (item?.UserId > 0)
                                    {
                                        <label class="tealcolor">
                                            @item.UserName
                                        </label>
                                    }
                                </div>
                                @if (EditingItem == item)
                                {
                                    <div class="col-lg-3 col-xl-auto col-xsm-12 text-end">
                                        <select class="form-select" @bind="SelectedOptionFromHistory">
                                            @if (providers.DiagnosticCode is not null && providers.ChargeCode is not null)
                                            {
                                                @switch (SelectedType)
                                                {
                                                    case "Diagnostic Code":
                                                        @foreach (var DiagnosticList in providers.DiagnosticCode)
                                                        {
                                                            <option value="@DiagnosticList.DiagnosticCodeName-@DiagnosticList.DiagnosticCodeDescription">@DiagnosticList.DiagnosticCodeName-@DiagnosticList.DiagnosticCodeDescription</option>
                                                        }
                                                        break;
                                                    case "Charge Code":
                                                        @foreach (var ChargeList in providers.ChargeCode)
                                                        {
                                                            <option value="@ChargeList.ChargeCodeName-@ChargeList.ChargeCodeDescription">@ChargeList.ChargeCodeName-@ChargeList.ChargeCodeDescription</option>
                                                        }
                                                        break;
                                                }
                                            }
                                        </select>
                                    </div>
                                    <div class="col-lg-auto col-xl-auto col-xsm-12 text-end">
                                        <select class="form-select" @onchange="SelectCodeType">
                                            @if (SelectedType == "Diagnostic Code")
                                            {
                                                <option value="Diagnostic Code">Diagnostic Code</option>
                                                <option value="Charge Code">Charge Code</option>
                                            }
                                            else
                                            {
                                                <option value="Charge Code">Charge Code</option>
                                                <option value="Diagnostic Code">Diagnostic Code</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-lg-auto col-xl-auto col-xsm-12 text-end d-flex">
                                        <DateInput @bind-SelectedDateTime="@SelectedDate" DateTimeBool=true />
                                        <input type="time" class="form-control" @bind="SelectedTime" />
                                    </div>
                                    <div class="col-lg-6 col-xl-6 col-xsm-6 pt-1 tealcolor align-content-center text-end">
                                        <button class="btn p-0" @onclick="CancelEdit">
                                            <svg width="30" height="31" viewBox="0 0 30 31" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                <rect y="0.503906" width="30" height="30" rx="15" fill="#FF5126" />
                                                <path fill-rule="evenodd" clip-rule="evenodd" d="M9.29279 10.2936C9.48031 10.1061 9.73462 10.0008 9.99979 10.0008C10.265 10.0008 10.5193 10.1061 10.7068 10.2936L14.9998 14.5866L19.2928 10.2936C19.385 10.1981 19.4954 10.1219 19.6174 10.0695C19.7394 10.0171 19.8706 9.98947 20.0034 9.98832C20.1362 9.98717 20.2678 10.0125 20.3907 10.0627C20.5136 10.113 20.6253 10.1873 20.7192 10.2812C20.8131 10.3751 20.8873 10.4867 20.9376 10.6096C20.9879 10.7325 21.0132 10.8642 21.012 10.997C21.0109 11.1298 20.9833 11.261 20.9309 11.383C20.8785 11.505 20.8023 11.6153 20.7068 11.7076L16.4138 16.0006L20.7068 20.2936C20.8889 20.4822 20.9897 20.7348 20.9875 20.997C20.9852 21.2592 20.88 21.51 20.6946 21.6954C20.5092 21.8808 20.2584 21.986 19.9962 21.9882C19.734 21.9905 19.4814 21.8897 19.2928 21.7076L14.9998 17.4146L10.7068 21.7076C10.5182 21.8897 10.2656 21.9905 10.0034 21.9882C9.74119 21.986 9.49038 21.8808 9.30497 21.6954C9.11956 21.51 9.01439 21.2592 9.01211 20.997C9.00983 20.7348 9.11063 20.4822 9.29279 20.2936L13.5858 16.0006L9.29279 11.7076C9.10532 11.52 9 11.2657 9 11.0006C9 10.7354 9.10532 10.4811 9.29279 10.2936Z" fill="white" />
                                            </svg>
                                        </button>
                                    </div>
                                    <div class="col-lg-6 col-xl-6 col-xsm-6 pt-1 tealcolor align-content-center text-start">
                                        <button class="btn p-0" @onclick="UpdateHistory" id="myButton">
                                            <svg width="30" height="31" viewBox="0 0 30 31" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                <rect y="0.503906" width="30" height="30" rx="15" fill="#00BF80" />
                                                <path fill-rule="evenodd" clip-rule="evenodd" d="M21.7103 10.7967C21.8978 10.9842 22.0031 11.2385 22.0031 11.5037C22.0031 11.7689 21.8978 12.0232 21.7103 12.2107L13.7103 20.2107C13.5228 20.3982 13.2685 20.5035 13.0033 20.5035C12.7382 20.5035 12.4839 20.3982 12.2963 20.2107L8.29634 16.2107C8.11418 16.0221 8.01338 15.7695 8.01566 15.5073C8.01794 15.2451 8.12311 14.9943 8.30852 14.8089C8.49393 14.6235 8.74474 14.5183 9.00694 14.516C9.26913 14.5137 9.52173 14.6145 9.71034 14.7967L13.0033 18.0897L20.2963 10.7967C20.4839 10.6092 20.7382 10.5039 21.0033 10.5039C21.2685 10.5039 21.5228 10.6092 21.7103 10.7967Z" fill="white" />
                                            </svg>
                                        </button>
                                    </div>
                                    <div class="col-lg-12 col-xl-12 col-xsm-12 pt-1 tealcolor align-content-center text-center">
                                        <span class="text-danger">@DateErrorMessage</span>
                                    </div>
                                }
                                else
                                {
                                    <div class="col-lg-3 col-xsm-12 text-center">
                                        <span class="me-1 tealcolor">@item.Code @item.Description </span>
                                    </div>
                                    <div class="col-lg-3">
                                        <span class="me-1 tealcolor">@item.Type </span>
                                    </div>
                                    <div class="col-lg tealcolor">
                                        @item?.CreatedAt.ToString("MM/dd/yyyy hh:mm tt")
                                    </div>
                                    @if (item.CurrentlyAdded && item.Id.HasValue)
                                    {
                                        <div class="col-lg-auto tealcolor">
                                            <button class="col-2 btn p-0" @onclick="()=>DeleteVisitHistory(item)">
                                                <img src="/images/deletebutton.png" />
                                            </button>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="col-lg-auto tealcolor">
                                            <button class="col-2 btn p-0" @onclick="()=>EditItem(item)">
                                                <svg width="30" height="31" viewBox="0 0 30 31" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                    <rect y="0.503906" width="30" height="30" rx="15" fill="#2474B3" />
                                                    <path d="M18.586 9.09105C18.7705 8.90002 18.9912 8.74766 19.2352 8.64284C19.4792 8.53802 19.7416 8.48285 20.0072 8.48054C20.2728 8.47824 20.5361 8.52884 20.7819 8.6294C21.0277 8.72996 21.251 8.87847 21.4388 9.06626C21.6266 9.25404 21.7751 9.47734 21.8756 9.72314C21.9762 9.96893 22.0268 10.2323 22.0245 10.4978C22.0222 10.7634 21.967 11.0258 21.8622 11.2699C21.7574 11.5139 21.605 11.7346 21.414 11.919L20.621 12.712L17.793 9.88405L18.586 9.09105ZM16.379 11.298L8 19.677V22.505H10.828L19.208 14.126L16.378 11.298H16.379Z" fill="white" />
                                                </svg>
                                            </button>
                                        </div>
                                    }
                                }
                            </div>
                        }

                    }
                }
            </div>
        </div>
        <br />
    </div>
}
