    public async Task DeleteVisitHistory(ResponseModel model)
    {
        var resp = await httpclient.DeleteFromJsonAsync<bool>($"api/PatientCode/VisitHistory/DeleteVisitHistory/{model.Id}");

        if (resp == true)
        {
            Codes?.Remove(model);

            if (model.Type == "Diagnostic Code")
            {
                VisitHistories?.Remove(VisitHistories.Find(x => x.Id == model.Id));
            }
            else
            {
                VisitHistories?.Remove(VisitHistories.Find(x => x.Id == model.Id));
            }
            StateHasChanged();
        }

    }
    private void EditItem(ResponseModel item)
    {
        EditingItem = item;
        SelectedType = EditingItem.Type;
        LastSelectedType = SelectedType;
        SelectedOptionFromHistory = EditingItem.Code + "-" + EditingItem.Description;
        SelectedDate = EditingItem.CreatedAt;
        SelectedTime = EditingItem.CreatedAt;
    }
    private async Task SelectCodeType(ChangeEventArgs e)
    {
        SelectedType = e.Value.ToString();
        EditingItem.Type = SelectedType;
        @switch (SelectedType)
        {
            case "Diagnostic Code":
                SelectedOptionFromHistory = providers.DiagnosticCode.FirstOrDefault().DiagnosticCodeName + "-" + providers.DiagnosticCode.FirstOrDefault().DiagnosticCodeDescription;
                break;
            case "Charge Code":
                SelectedOptionFromHistory = providers.ChargeCode.FirstOrDefault().ChargeCodeName + "-" + providers.ChargeCode.FirstOrDefault().ChargeCodeDescription;
                break;
        }
    }
    private async Task<bool> CancelEdit()
    {
        if (EditingItem != null)
        {
            @switch (LastSelectedType)
            {
                case "Diagnostic Code":
                    EditingItem.Type = "Diagnostic Code";
                    break;
                case "Charge Code":
                    EditingItem.Type = "Charge Code";
                    break;
            }
            EditingItem = null;
            return true;
        }
        else
        {
            return false;
        }
    }
