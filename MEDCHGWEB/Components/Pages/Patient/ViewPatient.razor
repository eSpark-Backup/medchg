                <div class="col-3 p-1 bg-white border border-2 rounded-2 text-center tealcolor simple-patient-view" data-testid="building-name">
                    @(selectedBuildingDesc == null ? "+ select Building" : selectedBuildingDesc?.Name + "  " + selectedBuildingDesc?.BuildingLocation)
                    <i class="fas fa-trash-can ml-2" @onclick="ShowDeleteBuildingModal" style="cursor:pointer" data-testid="delete-building-icon"></i>
                </div>
                <div class="col-xsm-11 mb-2 p-1 bg-white border border-2 rounded-2 text-center tealcolor responsive-patient-view" data-testid="building-name-mobile">
                    @(selectedBuildingDesc == null ? "+ select Building" : selectedBuildingDesc?.Name + "  " + selectedBuildingDesc?.BuildingLocation)
                    <i class="fas fa-trash-can ml-2" @onclick="ShowDeleteBuildingModal" style="cursor:pointer" data-testid="delete-building-icon-mobile"></i>
                </div>
                @if (selectedFloorDesc == null)
                {
                    <div class="col-xsm-11 mb-2 p-1 bg-white border border-2 rounded-2 text-center tealcolor responsive-patient-view btn" @onclick="ShowFloorModal" data-testid="select-floor-button">
                        <i class="fas fa-plus"></i> Select Floor
                    </div>
                    <div class="col-3 ms-3 p-1 bg-white border border-2 rounded-2 text-center tealcolor simple-patient-view" @onclick="ShowFloorModal" style="cursor:pointer" data-testid="select-floor-small-button">
                        <i class="fas fa-plus"></i> Select Floor
                    </div>
                }
                else
                {
                    <div class="col-3 ms-3 p-1 bg-white border border-2 rounded-2 text-center tealcolor simple-patient-view" data-testid="floor-name">
                        @(selectedFloorDesc == null ? "+ select Floor" : "Floor: " + selectedFloorDesc?.Name)
                        <i class="fas fa-trash-can ml-2" @onclick="ShowDeleteFloorModal" style="cursor:pointer" data-testid="delete-floor-icon"></i>
                    </div>
                    <div class="col-xsm-11 mb-2 p-1 bg-white border border-2 rounded-2 text-center tealcolor responsive-patient-view" data-testid="floor-name-mobile">
                        @(selectedFloorDesc == null ? "+ select Floor" : "Floor: " + selectedFloorDesc?.Name)
                        <i class="fas fa-trash-can ml-2" @onclick="ShowDeleteFloorModal" style="cursor:pointer" data-testid="delete-floor-icon-mobile"></i>
                    </div>
                    @if (selectedRoomDesc == null)
                    {
                        <div class="col-xsm-11 mb-2 p-1 bg-white border border-2 rounded-2 text-center tealcolor responsive-patient-view btn" @onclick="ShowRoomModal" data-testid="select-room-button">
                            <i class="fas fa-plus"></i> Select Room
                        </div>
                        <div class="col-3 ms-3 p-1 bg-white border border-2 rounded-2 text-center tealcolor simple-patient-view" @onclick="ShowRoomModal" style="cursor:pointer" data-testid="select-room-small-button">
                            <i class="fas fa-plus"></i> Select Room
                        </div>
                    }
                    else
                    {
                        <div class="col-3 ms-3 p-1 bg-white border border-2 rounded-2 text-center tealcolor simple-patient-view" data-testid="room-name">
                            @(selectedRoomDesc == null ? "+ select Room" : "Room: " + selectedRoomDesc?.Name)
                            <i class="fas fa-trash-can ml-2" @onclick="ShowDeleteRoomModal" style="cursor:pointer" data-testid="delete-room-icon"></i>
                        </div>
                        <div class="col-xsm-11 mb-2 p-1 bg-white border border-2 rounded-2 text-center tealcolor responsive-patient-view" data-testid="room-name-mobile">
                            @(selectedRoomDesc == null ? "+ select Room" : "Room: " + selectedRoomDesc?.Name)
                            <i class="fas fa-trash-can ml-2" @onclick="ShowDeleteRoomModal" style="cursor:pointer" data-testid="delete-room-icon-mobile"></i>
                        </div>
                    }
                }
            }
        </div>
        <div class="row mt-3 mb-3 justify-content-center">
            <button class="col-lg-2 col-xsm-10 btn btn-primary" @onclick="()=>OpenModal(true,1)" data-testid="relocate-button">
                Relocate
