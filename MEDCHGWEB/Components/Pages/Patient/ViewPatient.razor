                                    </div>
                                    <div class="col-3">
                                        <button class="col-12 btn btn-sm btn-danger" name="Delete Manual Charge Code" data-test-id="Delete-Manual-Charge-Code" @onclick="() => ShowDeleteManualChargeCodeModal(item.Id)"><i class="fas fa-trash-can"></i></button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                <div class="row mt-3 mb-3 justify-content-center">
                    <button class="col-4 bg-white tealcolor btn border border-2 rounded-2" name="Enter Code Manually" data-test-id="Enter-Code-Manually-Charge-Code" @onclick="OnShowManualChargeModal">
