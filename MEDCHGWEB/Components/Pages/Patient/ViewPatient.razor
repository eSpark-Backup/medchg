    private MEDCHGWEB.Components.Pages.CommomModal.DeleteModal Deletecensusstatus;
    private MEDCHGWEB.Components.Pages.CommomModal.DeleteModal DeleteManualChargeCode;
    private MEDCHGWEB.Components.Pages.CommomModal.DeleteModal DeleteManualDiagnosticCode;
