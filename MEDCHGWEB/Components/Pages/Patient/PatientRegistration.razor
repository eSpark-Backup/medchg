@page "/PatientRegistration"
@rendermode InteractiveServer
@using MEDCHGWEB.Components.CustomComponents
@using Microsoft.AspNetCore.WebUtilities;
@using System.Globalization
@inject AuthenticationStateProvider AuthenticationStateProvider
@attribute [Authorize(Roles = "Doctor, User, Editor Access")]
<script>
    function getValueById(id) {
        return document.getElementById(id).value;
    }

    window.capitalizeFirstLetter = (inputId) => {
        let input = document.getElementById(inputId);
        if (input) {
            let value = input.value.trim();
            if (value.length > 0) {
                input.value = value.charAt(0).toUpperCase() + value.slice(1);
            }
        }
    };
</script>

<div class="container border border-3 rounded-3 bg-Indigo-20">
    <div class="row bg-white border border-bottom-4">
        <div class="col-5 pt-1 text-end">
            <svg width="72" height="60" viewBox="0 0 82 82" fill="none" xmlns="http://www.w3.org/2000/svg" style="height: 5rem;padding-top: 5px;">
