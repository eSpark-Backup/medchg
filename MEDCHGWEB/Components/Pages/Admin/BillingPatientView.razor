@code {
    private ManualCodeModal ManuaDiagnosticCodeModal = new();
    private ManualCodeModal ManualChargeCodeCodeModal = new();
    public bool ModalOpt;
    public string ModalDisplay = "none;";
    public string ModalClass = "";
    public bool ShowBackdrop = false;
    private List<ChargeCode> ChargeCodes = new();
    private List<DiagnosticCode> DiagnosticCodes = new();
    private List<Building> Buildings = new();
    private List<Floor> Floors = new();
    private List<Room> Rooms = new();
    private List<Building> DisplayBuildings = new();
    private List<Floor> DisplayFloors = new();
    private List<Room> DisplayRooms = new();
    private List<User> Practitioners = new();
    private bool IsDropdownOpen = false;
    private string DropdownStyle => IsDropdownOpen ? "display: block;" : "display: none;";
    string FirstName;
    string MiddleName;
    string LastName;
    private string SelectedCodeType = "Diagnostic Code";
    private string SelectedCodeSubType;
    private string SelectedCode;
    private string SelectedCodeDesc;
    private int SelectedId;
    private DateTime? SelectedDate;
    private DateTime SelectedTime;
    private int? _SelectedBuilding;
    public string ErrorMessage;
    public string? HeaderText { get; set; }
    public string? BodyDescription { get; set; }
    public PatientVisitHistoryDetailList? DeletedSelectedItem { get; set; }
    public int? SelectedBuilding
    {
        get
        {
            return _SelectedBuilding;
        }
        set
        {
            _SelectedBuilding = value;
            Floors = DisplayFloors.Where(x => x.BuildingId == value).ToList();
            if (Floors.Count() is 0)
            {
                SelectedFloor = 0;
            }
            else
            {
                SelectedFloor = Floors.FirstOrDefault().Id;
            }
        }
    }
    private int? _SelectedFloor;

    public int? SelectedFloor
    {
        get
        {
            return _SelectedFloor;
        }
        set
        {
            _SelectedFloor = value;
            Rooms = DisplayRooms.Where(x => x.FloorId == value).ToList();
            if (Rooms.Count() is 0)
            {
                SelectedPractitioner = 0;
            }
            else
            {
                SelectedRoom = Rooms.FirstOrDefault().Id;
            }
        }
    }
    public int? SelectedRoom;
    public int? SelectedPractitioner;
    private bool IsChecked { get; set; } = false;

    protected override async Task OnInitializedAsync()
    {
        SelectedDate = TimeHelper.GetTexasTime();
        SelectedTime = TimeHelper.GetTexasTime();
        ChargeCodes = await httpclient.GetFromJsonAsync<List<ChargeCode>>($"api/Provider/GetAllChargeCodesByProviderId{AppState.currentUser.ProviderId}");
        DiagnosticCodes = await httpclient.GetFromJsonAsync<List<DiagnosticCode>>($"api/Provider/GetAllDiagnosticCodesByProviderId{AppState.currentUser.ProviderId}");
        Buildings = await httpclient.GetFromJsonAsync<List<Building>>($"api/Building/GetAllBuildings");
        Practitioners = await httpclient.GetFromJsonAsync<List<User>>($"api/User/GetAllUsersByProviderIdAsync/{AppState.currentUser.ProviderId}");
        Buildings = Buildings.Where(x => x.HospitalId == AppState.PatientDTO.PatientVisitHistoryDetailListObj.HospitalId).ToList();
        DisplayFloors = await httpclient.GetFromJsonAsync<List<Floor>>($"api/Floor/GetAllFloors");
        DisplayRooms = await httpclient.GetFromJsonAsync<List<Room>>($"api/Room/GetAllRooms");
        string[] Names = AppState.PatientDTO.PatientObj.Name.Split(' ');
        FirstName = Names[0];
        MiddleName = Names[1] == "" ? "N/A" : Names[1];
        LastName = Names[2];
    }
