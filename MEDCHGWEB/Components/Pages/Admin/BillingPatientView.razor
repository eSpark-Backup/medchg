    public async Task OpenModal(int i, PatientVisitHistoryDetailList Model)
    {
        switch (i)
        {
            case 1:
                ModalDisplay = "block;";
                HeaderText = "Close billing record?";
                BodyDescription = $"Are you sure you want to close transactions for this visit of {AppState.PatientDTO.PatientObj.Name}?";
                await Task.Delay(100);
                ModalClass = "show";
                ShowBackdrop = true;
                IsChecked = true;
                break;
            case 2:
                ManuaDiagnosticCodeModal.ErrorMessage = "";
                if (SelectedCode is not null)
                {
                    ManuaDiagnosticCodeModal.ManualCode = SelectedCode;
                    ManuaDiagnosticCodeModal.ManualDesc = string.IsNullOrWhiteSpace(SelectedCodeDesc) ? "" : SelectedCodeDesc;
                }
                await ManuaDiagnosticCodeModal.OpenModal(true);
                break;
            case 3:
                DeletedSelectedItem = Model;
                ModalDisplay = "block;";
                HeaderText = "Delete";
                BodyDescription = $"Are you sure you want to delete this code?";
                await Task.Delay(100);
                ModalClass = "show";
                ShowBackdrop = true;
                break;
            default:
                ManualChargeCodeCodeModal.ErrorMessage = "";
                if (SelectedCode is not null)
                {
                    ManualChargeCodeCodeModal.ManualCode = SelectedCode;
                    ManualChargeCodeCodeModal.ManualDesc = string.IsNullOrWhiteSpace(SelectedCodeDesc) ? "" : SelectedCodeDesc;
                }
                await ManualChargeCodeCodeModal.OpenModal(true);
                break;
        }
        IsDropdownOpen = false;
        StateHasChanged();
    }
    public async Task CloseModal()
    {
        ModalClass = "";
        await Task.Delay(250);
        ModalDisplay = "none";
        ShowBackdrop = false;
        IsChecked = false;
        StateHasChanged();
    }

    public async Task BilledPatient()
    {
        AppState.PatientVisitHistory.UpdatedById = Convert.ToInt32(AppState.currentUser.Id);
        AppState.PatientVisitHistory.PatientCensusStatus = CensusStatus.BILLED;
        var BillingResponse = await httpclient.PostAsJsonAsync($"api/Billing/UpdateCensusState/{AppState.PatientVisitHistory.PatientId}",
          AppState.PatientVisitHistory
          );
        if (BillingResponse.IsSuccessStatusCode)
        {
            Navigation.NavigateTo("/Admin/Billing");
        }
    }
    public async Task AddNote(PatientVisitHistoryDetailList Model)
    {
        var Obj = CreatePatientObj(Model);
        var resp = await httpclient.PostAsJsonAsync($"api/Billing/UpdateHistory", Obj);
        if (resp.IsSuccessStatusCode)
        {
            var existingItem = AppState.PatientDTO.PatientVisitHistoryDetailLists
      .FirstOrDefault(x => x.Id == Model.Id);
            if (existingItem != null)
            {
                // Update the item's properties
                existingItem.Note = Model.Note;
            }
        }
    }
    public async Task DeleteHistory(PatientVisitHistoryDetailList Model)
    {
        Model.IsActive = 2;
        var Obj = CreatePatientObj(Model);
        var resp = await httpclient.PostAsJsonAsync($"api/Billing/UpdateHistory", Obj);
        if (resp.IsSuccessStatusCode)
        {
            AppState.PatientDTO.PatientVisitHistoryDetailLists.Remove(Model);
        }
        await CloseModal();
    }
