@page "/Admin/BillingPatientView"
@using MEDCHGClassLibrary.ViewModels.Hospital
@using MEDCHGWEB.Components.Pages.Patient
@using MEDCHGWEB.Services
@inject AppState AppState
@layout BillingLayout
@rendermode InteractiveServer
<div class="container">
    <div class="row bg-white border border-2 rounded-3 p-4">
        <div class="col-lg-12 p-0 mb-4">
            <div class="col-lg-12 border border-2 rounded-2 rounded-bottom-0 text-center bg-teal-70 text-white py-2">
                <div class="row justify-content-center">
                    <div class="col-lg-auto simple-patient-view align-content-center">
                        <h3>
                            @AppState.PatientDTO.PatientObj.Name &nbsp; &nbsp;  &nbsp;
                        </h3>
                    </div>
                    <div class="col-lg-auto simple-patient-view text-center p-0 align-content-center">
                        <svg width="20" height="35" viewBox="0 0 1 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <line x1="0.5" y1="2.18557e-08" x2="0.499999" y2="14" stroke="#C1C6E6" />
                        </svg>
                    </div>
                    <div class="col-xsm-2 responsive-patient-view text-end p-0">
                    </div>
                    <div class="col-xsm-8 responsive-patient-view align-content-center text-center">
                        <h3 class="mb-0" style="font-size:1.32rem;height: 30px;">
                            @AppState.PatientDTO.PatientObj.Name &nbsp; &nbsp;  &nbsp;
                        </h3>
                    </div>
                    <div class="col-xsm-2 p-0 responsive-patient-view align-content-center">
                        <button type="button" class="border-0 bg-transparent" @onclick="NavigateToEditPatient" data-test-id="edit-patient-button">
                            <img src="/images/editbutton.png" style="width:37px;" />
                        </button>
                    </div>
                    <div class="col-lg-2 col-xsm-12 d-flex align-items-center">
                        <div class="col-lg col-xsm-7 border border-2 rounded-start-2 bg-Indigo-10 shadow align-items-center" style="padding:5px">
                            <h5 class="m-0 tealcolor align-content-center" style="height:2rem">Done</h5>
                        </div>
                        <div class="col-lg-auto col-xsm-7 border border-2 rounded-end-2 bg-Indigo-10 shadow" style="padding:5px">
                            <span class="form-switch-big text-center">
                                <input class="form-check-input-big ms-2 mt-0" @bind="IsChecked" type="checkbox" @oninput="()=>OpenModal(1,null)" data-test-id="done-checkbox" />
                            </span>
                        </div>
                    </div>
                    <div class="col-lg-3 simple-patient-view align-content-center text-end">
                        <button type="button" class="border-0 bg-transparent" @onclick="NavigateToEditPatient" data-test-id="edit-patient-button-secondary">
                            <img src="/images/editbutton.png" style="width:45px;" />
                        </button>
                    </div>
                </div>
            </div>
            <div class="col-lg-12 border border-2 rounded-2 rounded-top-0 border-top-1 bg-Indigo-20">
                <div class="row p-3 justify-content-center">
                    <div class="col-lg-6 simple-patient-view">
                        <div class="row border border-2 rounded-2 shadow p-1 justify-content-center bg-white">
                            <div class="col-lg-4 text-start ps-4 align-content-center">
                                <h5 class="m-0">
                                    <span class="tealcolor">First: </span> @FirstName
                                </h5>
                            </div>
                            <div class="col-lg-auto col-xsm-auto text-center p-0">
                                <svg width="2" height="35" viewBox="0 0 1 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <line x1="0.5" y1="2.18557e-08" x2="0.499999" y2="14" stroke="#C1C6E6" />
                                </svg>
                            </div>
                            <div class="col-lg-3 text-center align-content-center">
                                <h5 class="m-0">
                                    <span class="tealcolor">Middle: </span> @MiddleName
                                </h5>
                            </div>
                            <div class="col-lg-auto col-xsm-auto text-center p-0">
                                <svg width="2" height="35" viewBox="0 0 1 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <line x1="0.5" y1="2.18557e-08" x2="0.499999" y2="14" stroke="#C1C6E6" />
                                </svg>
                            </div>
                            <div class="col-lg-4 text-center align-content-center">
                                <h5 class="m-0">
                                    <span class="tealcolor">Last: </span> @LastName
                                </h5>
                            </div>
                        </div>
                        <br />
                        <div class="row border border-2 rounded-2 shadow p-1 text-center justify-content-center bg-white">
                            <div class="col-lg-4 col-xsm-3 align-content-center">
                                <h5 class="m-0">
                                    <span class="tealcolor">MRN: </span> @AppState.PatientDTO.PatientObj.MRN
                                </h5>
                            </div>
                            <div class="col-lg-auto col-xsm-auto text-center p-0">
                                <svg width="2" height="35" viewBox="0 0 1 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <line x1="0.5" y1="2.18557e-08" x2="0.499999" y2="14" stroke="#C1C6E6" />
                                </svg>
                            </div>
                            <div class="col-lg-3 col-xsm-2 align-content-center">
                                <h5 class="m-0">
                                    <span class="tealcolor">Age: </span> 
                                        @CalCulateAge.AgeCalculator(AppState.PatientDTO.PatientObj.DateOfBirth)
                                </h5>
                            </div>
                            <div class="col-lg-auto col-xsm-auto text-center p-0">
                                <svg width="2" height="35" viewBox="0 0 1 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <line x1="0.5" y1="2.18557e-08" x2="0.499999" y2="14" stroke="#C1C6E6" />
                                </svg>
                            </div>
                            <div class="col-lg-4 col-xsm-4 align-content-center">
                                <h5 class="m-0">
                                    <span class="tealcolor">Gender: </span>
                                    @if (AppState.PatientDTO.PatientObj.Gender is Gender.Male)
                                    {
                                        <span>
                                            Male
                                        </span>
                                    }
                                    else
                                    {
                                        <span>
                                            Female
                                        </span>
                                    }
                                </h5>
                            </div>
                        </div>
                        <br />
                        <div class="row border border-2 rounded-2 shadow p-1 bg-white">
                            <div class="col-lg-5 justify-content-center align-content-center">
                                <h5 class="m-0">
                                    <span class="tealcolor">Salutation: </span> @(string.IsNullOrEmpty(AppState.PatientDTO.PatientObj.Salutation) ? "N/A" : AppState.PatientDTO.PatientObj.Salutation)
                                </h5>
                            </div>
                            <div class="col-lg-auto col-xsm-auto text-center p-0">
                                <svg width="2" height="35" viewBox="0 0 1 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <line x1="0.5" y1="2.18557e-08" x2="0.499999" y2="14" stroke="#C1C6E6" />
                                </svg>
                            </div>
                            <div class="col-lg-6 text-end justify-content-center align-content-center">
                                <h5 class="m-0">
                                    <span class="tealcolor">Date of Birth: </span> @if (AppState.PatientDTO.PatientObj.DateOfBirth != null)
                                    {
                                        @AppState.PatientDTO.PatientObj.DateOfBirth.ToString("MM/dd/yyyy")
                                    }
                                </h5>
                            </div>
                        </div>
                        <br />
                        <div class="row border border-2 rounded-2 shadow p-1 bg-white">
                            <div class="col-lg-auto text-center align-content-center">
                                <h5 class="m-0">
                                    <span class="tealcolor">Admission Date: </span> @AppState.PatientVisitHistory.PatientAddmissionDate?.ToString("MM/dd/yyyy")
                                </h5>
                            </div>
                            <div class="col-lg-auto col-xsm-auto text-center p-0">
                                <svg width="2" height="35" viewBox="0 0 1 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <line x1="0.5" y1="2.18557e-08" x2="0.499999" y2="14" stroke="#C1C6E6" />
                                </svg>
                            </div>
                            <div class="col-lg-auto text-center align-content-center">
                                <h5 class="m-0">
                                    <span class="tealcolor">Admission Time: </span> @AppState.PatientVisitHistory.PatientAddmissionTime?.ToString("hh:mm tt")
                                </h5>
                            </div>
                        </div>
                    </div>
                    <div class="col-xsm-11 responsive-patient-view">
                        <br />
                        <div class="row border border-2 rounded-2 shadow p-1 align-items-center bg-white justify-content-center">
                            <div class="col-xsm-auto ps-0 text-center justify-content-center">
                                <h5 class="m-0" style="font-size:4vw" data-test-id="first-name">
                                    <span class="tealcolor">F: </span> @FirstName
                                </h5>
                            </div>
                            <div class="col-xsm-auto text-center p-0">
                                <svg width="2" height="35" viewBox="0 0 1 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <line x1="0.5" y1="2.18557e-08" x2="0.499999" y2="14" stroke="#C1C6E6" />
                                </svg>
                            </div>
                            <div class="col-xsm-auto text-center justify-content-center">
                                <h5 class="m-0" style="font-size:4vw" data-test-id="middle-name">
                                    <span class="tealcolor">M: </span> @MiddleName
                                </h5>
                            </div>
                            <div class="col-xsm-auto text-center p-0">
                                <svg width="2" height="35" viewBox="0 0 1 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <line x1="0.5" y1="2.18557e-08" x2="0.499999" y2="14" stroke="#C1C6E6" />
                                </svg>
                            </div>
                            <div class="col-xsm-auto text-center justify-content-center">
                                <h5 class="m-0" style="font-size:4vw" data-test-id="last-name">
                                    <span class="tealcolor">L: </span> @LastName
                                </h5>
                            </div>
                        </div>
                        <br />
                        <div class="row border border-2 rounded-2 shadow p-1 text-center bg-white justify-content-center">
                            <div class="col-lg-3 ps-0 col-xsm-auto align-content-center">
                                <h5 class="m-0" style="font-size:4vw" data-test-id="mrn">
                                    <span class="tealcolor">MRN: </span> @AppState.PatientInfo.MRN
                                </h5>
                            </div>
                            <div class="col-lg col-xsm-auto text-center p-0">
                                <svg width="2" height="35" viewBox="0 0 1 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <line x1="0.5" y1="2.18557e-08" x2="0.499999" y2="14" stroke="#C1C6E6" />
                                </svg>
                            </div>
                            <div class="col-lg-2 col-xsm-auto align-content-center">
                                <h5 class="m-0" style="font-size:4vw" data-test-id="age">
                                    <span class="tealcolor">Age: </span> @if (AppState.PatientVisitHistory.PatientAge != null)
                                    {
                                        @AppState.PatientVisitHistory.PatientAge
                                    }
                                </h5>
                            </div>
                            <div class="col-lg col-xsm-auto text-center p-0">
                                <svg width="2" height="35" viewBox="0 0 1 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <line x1="0.5" y1="2.18557e-08" x2="0.499999" y2="14" stroke="#C1C6E6" />
                                </svg>
                            </div>
                            <div class="col-lg-4 col-xsm-auto pe-0 align-content-center">
                                <h5 class="m-0" style="font-size:4vw" data-test-id="gender">
                                    @if (AppState.PatientInfo.Gender is Gender.Male)
                                    {
                                        <span class="tealcolor">
                                            Gender: Male
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="tealcolor">
                                            Gender: Male
                                        </span>
                                    }
                                </h5>
                            </div>
                        </div>
                        <br />
                        <div class="row border border-2 rounded-2 shadow p-1 bg-white justify-content-center">
                            <div class="col-xsm-auto ps-0 text-center justify-content-center align-content-center">
                                <h5 class="m-0" style="font-size:3.5vw" data-test-id="salutation">
                                    <span class="tealcolor">Salutation: </span> @AppState.PatientInfo.Salutation
                                </h5>
                            </div>
                            <div class="col-lg col-xsm-auto text-center p-0">
                                <svg width="2" height="35" viewBox="0 0 1 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <line x1="0.5" y1="2.18557e-08" x2="0.499999" y2="14" stroke="#C1C6E6" />
                                </svg>
                            </div>
                            <div class="col-xsm-auto pe-0 text-center justify-content-center align-content-center">
                                <h5 class="m-0" style="font-size:3.5vw;padding-left:9px !important;" data-test-id="dob">
                                    <span class="tealcolor">Date of Birth: </span> @if (AppState.PatientInfo.DateOfBirth != null)
                                    {
                                        @AppState.PatientInfo.DateOfBirth.ToString("MM/dd/yyyy")
                                    }
                                </h5>
                            </div>
                        </div>
                        <br />
                        <div class="row border border-2 rounded-2 shadow p-1 align-items-center bg-white justify-content-center">
                            <div class="col-xsm-auto ps-0 text-center justify-content-center">
                                <h5 class="m-0" style="font-size:3vw" data-test-id="admission-date">
                                    <span class="tealcolor">Admission Date: </span> @AppState.PatientVisitHistory.PatientAddmissionDate?.ToString("MM/dd/yyyy")
                                </h5>
                            </div>
                            <div class="col-xsm-auto text-center p-0">
                                <svg width="2" height="35" viewBox="0 0 1 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <line x1="0.5" y1="2.18557e-08" x2="0.499999" y2="14" stroke="#C1C6E6" />
                                </svg>
                            </div>
                            <div class="col-xsm-auto pe-0 text-center justify-content-center">
                                <h5 class="m-0" style="font-size:3vw" data-test-id="admission-time">
                                    <span class="tealcolor">Admission Time: </span> @AppState.PatientVisitHistory.PatientAddmissionTime?.ToString("hh:mm tt")
                                </h5>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        @switch (AppState.BillingPVTab)
        {
            case 1:
                <div class="col-lg-12 p-0 mb-4">
                    <div class="col-lg-12 border border-2 rounded-2 rounded-bottom-0 text-center bg-teal-70 text-white py-2 d-flex justify-content-around align-items-center p-3">
                        <div class="col-lg">
                            <h6 class="m-0">
                                Date & Time
                            </h6>
                        </div>
                        <div class="col-lg-auto">
                            <h6 class="m-0">
                                Practitioner
                            </h6>
                        </div>
                        <div class="col-lg-1">
                            <h6 class="m-0">
                                Location
                            </h6>
                        </div>
                        <div class="col-lg">
                            <h6 class="m-0">
                                Description
                            </h6>
                        </div>
                        <div class="col-lg">
                            <h6 class="m-0">
                                Diagnostic Code
                            </h6>
                        </div>
                        <div class="col-lg">
                            <h6 class="m-0">
                                Charge Code
                            </h6>
                        </div>
                        <div class="col-lg-1">
                            <h6 class="m-0">
                                Action
                            </h6>
                        </div>
                        <div class="col-lg-2">
                            <h6 class="m-0">
                                Note
                            </h6>
                        </div>
                    </div>
                    <div class="col-lg-12 border border-2 rounded-2 rounded-top-0 border-top-1 bg-Indigo-20">
                        @foreach (var item in AppState.PatientDTO.PatientVisitHistoryDetailLists.Where(x=>string.IsNullOrWhiteSpace(x.CodeName)!=true).OrderByDescending(x=>x.Date))
                        {
                            <div class="row justify-content-around align-items-center p-2 text-center border-3 border-bottom m-0">
                                <div class="col-lg">
                                    <h6 class="m-0" data-test-id="visit-date-1">
                                        @item.Date.ToString("MM/dd/yyyy")
                                        <br />
                                        @item.Date.ToString("hh:mm tt")
                                    </h6>
                                </div>
                                <div class="col-lg-1">
                                    <h6 class="m-0" data-test-id="practitioner-name-1">
                                        @((item.PractitionerName ?? "") == "" ? "N/A" : item.PractitionerName)
                                    </h6>
                                </div>
                                <div class="col-lg-1">
                                    <h6 class="m-0" data-test-id="location-1">
                                        @Buildings.Where(x => x.Id == item.BuildingId).FirstOrDefault()?.Name
                                        @DisplayFloors.Where(x => x.Id == item.FloorId).FirstOrDefault()?.Name
                                        @DisplayRooms.Where(x => x.Id == item.RoomId).FirstOrDefault()?.Name
                                    </h6>
                                </div>
                                @if (item.CodeType == "Diagnostic Code")
                                {
                                    <div class="col-lg">
                                        <h6 class="m-0" data-test-id="code-description-1">
                                            @((item.CodeDescription ?? "") == "" ? "N/A" : item.CodeDescription)
                                        </h6>
                                    </div>
                                    <div class="col-lg">
                                        <h6 class="m-0" data-test-id="code-name-1">
                                            @((item.CodeName ?? "") == "" ? "N/A" : item.CodeName)
                                        </h6>
                                    </div>
                                    <div class="col-lg">
                                        <h6 class="m-0" data-test-id="n-a-1">
                                            N/A
                                        </h6>
                                    </div>
                                }
                                else
                                {
                                    <div class="col-lg">
                                        <h6 class="m-0" data-test-id="code-description-1">
                                            @((item.CodeDescription ?? "") == "" ? "N/A" : item.CodeDescription)
                                        </h6>
                                    </div>
                                    <div class="col-lg">
                                        <h6 class="m-0" data-test-id="n-a-1">
                                            N/A
                                        </h6>
                                    </div>
                                    <div class="col-lg">
                                        <h6 class="m-0" data-test-id="code-name-1">
                                            @((item.CodeName ?? "") == "" ? "N/A" : item.CodeName)
                                        </h6>
                                    </div>
                                }
                                <div class="col-lg-1 d-flex p-0 justify-content-around">
                                    <svg @onclick="()=>EditHistory(item)" width="37" height="36" viewBox="0 0 37 36" fill="none" xmlns="http://www.w3.org/2000/svg" style="cursor:pointer" data-test-id="edit-history-button-1">
                                        <rect x="1.375" y="0.5" width="35" height="35" rx="3.5" fill="#F2F4FC" />
                                        <rect x="1.375" y="0.5" width="35" height="35" rx="3.5" stroke="#5D8DB3" />
                                        <path d="M29.2544 7.61668C28.7293 7.09176 28.0173 6.79688 27.2748 6.79688C26.5323 6.79687 25.8203 7.09176 25.2952 7.61668L14.6748 18.2371V22.1963H18.634L29.2544 11.5759C29.7793 11.0508 30.0742 10.3387 30.0742 9.59628C30.0742 8.85382 29.7793 8.14175 29.2544 7.61668Z" fill="#0D8AA6" />
                                        <path fill-rule="evenodd" clip-rule="evenodd" d="M7.6748 12.3963C7.6748 11.6537 7.9698 10.9415 8.49491 10.4164C9.02001 9.89128 9.7322 9.59628 10.4748 9.59628H16.0748C16.4461 9.59628 16.8022 9.74378 17.0648 10.0063C17.3273 10.2689 17.4748 10.625 17.4748 10.9963C17.4748 11.3676 17.3273 11.7237 17.0648 11.9862C16.8022 12.2488 16.4461 12.3963 16.0748 12.3963H10.4748V26.3963H24.4748V20.7963C24.4748 20.425 24.6223 20.0689 24.8849 19.8063C25.1474 19.5438 25.5035 19.3963 25.8748 19.3963C26.2461 19.3963 26.6022 19.5438 26.8648 19.8063C27.1273 20.0689 27.2748 20.425 27.2748 20.7963V26.3963C27.2748 27.1389 26.9798 27.8511 26.4547 28.3762C25.9296 28.9013 25.2174 29.1963 24.4748 29.1963H10.4748C9.7322 29.1963 9.02001 28.9013 8.49491 28.3762C7.9698 27.8511 7.6748 27.1389 7.6748 26.3963V12.3963Z" fill="#0D8AA6" />
                                    </svg>
                                    <svg width="37" height="36" viewBox="0 0 37 36" fill="none" xmlns="http://www.w3.org/2000/svg" style="cursor:pointer" @onclick="()=>OpenModal(3,item)" data-test-id="open-modal-button-1">
                                        <rect x="1.375" y="0.5" width="35" height="35" rx="3.5" fill="#F2F4FC" />
                                        <rect x="1.375" y="0.5" width="35" height="35" rx="3.5" stroke="#484C4C" />
