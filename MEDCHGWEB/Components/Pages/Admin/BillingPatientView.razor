    private async Task Save()
    {
        try
        {
            var IsSelectedDate = await JS.InvokeAsync<bool>("validateDateFormat", SelectedDate?.ToString("o"));
            // Check both dates' validity and any other validation conditions
            if (!IsSelectedDate)
            {
                ErrorMessage = "Invalid Date Format!";
                return;
            }
            ErrorMessage = "";
            var newItems = new PatientVisitHistoryDetailList
                {
                    HospitalId = AppState.PatientDTO.PatientVisitHistoryDetailListObj.HospitalId,
                    BuildingId = SelectedBuilding,
                    FloorId = SelectedFloor,
                    RoomId = SelectedRoom,

                    Date = new DateTime(
                                             SelectedDate.Value.Year,
                                             SelectedDate.Value.Month,
                                             SelectedDate.Value.Day,
                                             SelectedTime.Hour,
                                             SelectedTime.Minute,
                                             SelectedTime.Second
                                             ),

                    CodeName = SelectedCode,
                    CodeDescription = SelectedCodeDesc,
                    CodeType = SelectedCodeType,
                    CodeSubType = SelectedCodeSubType,

                    PractitionerId = SelectedPractitioner,
                    PractitionerName = Practitioners.FirstOrDefault(x => x.Id == SelectedPractitioner).FullName,

                    PatientVisitHistoryId = AppState.PatientVisitHistory.Id,

                    CreatedById = Convert.ToInt32(AppState.currentUser.Id),
                    Device = "WEB"
                };
            var resp = await httpclient.PostAsJsonAsync<PatientVisitHistoryDetailList>($"api/PatientCode/VisitHistory/AddVisitHistoryDetail", newItems);
            if (resp.IsSuccessStatusCode)
            {
                var visitHistoryResult = await resp.Content.ReadFromJsonAsync<PatientVisitHistoryDetailList>();
                AppState.PatientDTO.PatientVisitHistoryDetailListObj.FloorId = newItems.FloorId;
                AppState.PatientDTO.PatientVisitHistoryDetailListObj.RoomId = newItems.RoomId;
                AppState.PatientDTO.PatientVisitHistoryDetailListObj.BuildingId = newItems.BuildingId;
                AppState.PatientDTO.FloorName = DisplayFloors.Where(x => x.Id == newItems.FloorId).FirstOrDefault().Name;
                AppState.PatientDTO.RoomName = DisplayRooms.Where(x => x.Id == newItems.RoomId).FirstOrDefault().Name;
                AppState.PatientDTO.BuildingName = Buildings.Where(x => x.Id == newItems.BuildingId).FirstOrDefault().Name;
                AppState.PatientDTOList.Add(AppState.PatientDTO);
                AppState.PatientDTO.PatientVisitHistoryDetailLists.Add(visitHistoryResult);
                AppState.BillingPVTab = 1;
                StateHasChanged();
            }
            else
            {
                // Handle unsuccessful login (Bad Request or other errors)
                // Read the content of the response
                var content = await resp.Content.ReadAsStringAsync();
                // Log or handle the error message as needed
                Console.WriteLine("Error: " + content);
                AppState.PatientDTO.PatientVisitHistoryDetailLists.Remove(newItems);
            }
        }
        catch (Exception ex)
        {
            Console.Write("Error Message ", ex.Message);
            throw;
        }
    }
    private PatientVisitHistory CreatePatientObj(PatientVisitHistoryDetailList newItems)
    {
        var UpdateHistory = new PatientVisitHistory();
        UpdateHistory.PatientCensusStatus = CensusStatus.DISCHARGED;
        UpdateHistory.PatientVisitHistoryDetailLists.Add(newItems);
        return UpdateHistory;
    }
    private async Task Update()
    {
        try
        {
            var IsSelectedDate = await JS.InvokeAsync<bool>("validateDateFormat", SelectedDate?.ToString("o"));
            // Check both dates' validity and any other validation conditions
            if (!IsSelectedDate)
            {
                ErrorMessage = "Invalid Date Format!";
                return;
            }
            ErrorMessage = "";
            var newItems = new PatientVisitHistoryDetailList
                {
                    Id = SelectedId,
                    HospitalId = AppState.PatientDTO.PatientVisitHistoryDetailListObj.HospitalId,
                    BuildingId = SelectedBuilding,
                    FloorId = SelectedFloor,
                    RoomId = SelectedRoom,

                    Date = new DateTime(
                    SelectedDate.Value.Year,
                    SelectedDate.Value.Month,
                    SelectedDate.Value.Day,
                    SelectedTime.Hour,
                    SelectedTime.Minute,
                    SelectedTime.Second
                    ),

                    CodeName = SelectedCode,
                    CodeDescription = SelectedCodeDesc,
                    CodeType = SelectedCodeType,
                    CodeSubType = SelectedCodeSubType == null ? "" : SelectedCodeSubType,

                    PractitionerId = SelectedPractitioner,
                    PractitionerName = Practitioners.FirstOrDefault(x => x.Id == SelectedPractitioner).FullName,

                    UpdatedById = Convert.ToInt32(AppState.currentUser.Id),
                    UpdatedAt = TimeHelper.GetTexasTime(),
                    Device = "WEB"
                };
            AppState.PatientVisitHistory.PatientCensusStatus = CensusStatus.DISCHARGED;
            AppState.PatientVisitHistory.UpdatedById = Convert.ToInt32(AppState.currentUser.Id);
            var Obj = CreatePatientObj(newItems);
            var resp = await httpclient.PostAsJsonAsync($"api/Billing/UpdateHistory", Obj);
            if (resp.IsSuccessStatusCode)
            {
                var existingItem = AppState.PatientDTO.PatientVisitHistoryDetailLists
    .FirstOrDefault(x => x.Id == SelectedId);
                if (existingItem != null)
                {
                    // Update the item's properties
                    existingItem.HospitalId = AppState.PatientDTO.PatientVisitHistoryDetailListObj.HospitalId;
                    existingItem.BuildingId = SelectedBuilding;
                    existingItem.FloorId = SelectedFloor;
                    existingItem.RoomId = SelectedRoom;
                    existingItem.Date = newItems.Date;
                    existingItem.CodeName = newItems.CodeName;
                    existingItem.CodeDescription = newItems.CodeDescription;
                    existingItem.CodeType = SelectedCodeType;
                    existingItem.CodeSubType = SelectedCodeSubType;
                    existingItem.PractitionerId = SelectedPractitioner;
                    existingItem.PractitionerName = Practitioners.FirstOrDefault(x => x.Id == SelectedPractitioner)?.FullName;
                    existingItem.UpdatedById = Convert.ToInt32(AppState.currentUser.Id);
                    existingItem.UpdatedAt = TimeHelper.GetTexasTime();
                    existingItem.Device = "WEB";
                }
                AppState.BillingPVTab = 1;
                StateHasChanged();
            }
            else
            {
                // Handle unsuccessful login (Bad Request or other errors)
                // Read the content of the response
                var content = await resp.Content.ReadAsStringAsync();
                // Log or handle the error message as needed
                Console.WriteLine("Error: " + content);
                AppState.PatientDTO.PatientVisitHistoryDetailLists.Remove(newItems);
            }
        }
        catch (Exception ex)
        {
            Console.Write("Error Message ", ex.Message);
            throw;
        }
    }
    private void ValidateAndLogProperties<T>(T model)
    {
        var properties = typeof(T).GetProperties();
        foreach (var property in properties)
        {
            var value = property.GetValue(model);
            if (value == null || (value is string str && string.IsNullOrEmpty(str)))
            {
                Console.WriteLine($"Error: {property.Name} is null or empty");
            }
        }
    }
