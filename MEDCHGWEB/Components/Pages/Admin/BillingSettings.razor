    public async Task SaveTimerSettings()
    {
        if (string.IsNullOrEmpty(TimerSettingDTO.GreenInDays))
        {
            errormessagename = "Please enter green day(s) value.";
        }
        else if (string.IsNullOrEmpty(TimerSettingDTO.YellowInDays))
        {
            errormessagename = "Please enter yellow day(s) value.";
        }
        else
        {
            if (currentUser != null && currentUser.ProviderId != null)
            {
                TimerSettingDTO.Id = 0;
                TimerSettingDTO.ProviderId = Convert.ToInt32(currentUser.ProviderId);
                var timerSetting = await httpclient.PostAsJsonAsync("api/Provider/SaveTimerSettings", TimerSettingDTO);
                if (timerSetting.IsSuccessStatusCode)
                {
                    await Task.Delay(400);
                    Navigation.NavigateTo($"/Admin/Billing");
                }
                else
                {
                    var content = await timerSetting.Content.ReadAsStringAsync();
                    errormessagename = content;
                }
            }
            else
            {
                Navigation.NavigateTo("/Account/Login?ReturnUrl=%2F", forceLoad: true);
            }
        }
    }

    public async Task RemoveDC(DiagnosticCodeDTO codes)
    {
        if (codes.Id.HasValue)
        {
            int id = codes.Id.Value;
            var DiagnosticCodesresponse = await httpclient.DeleteAsync($"api/DiagnosticCode/Delete{id}");
            if (DiagnosticCodesresponse.IsSuccessStatusCode)
            {
                var result = await DiagnosticCodesresponse.Content.ReadAsStringAsync();
                bool isDeleted = bool.Parse(result); // Parse the result to get the boolean value

                if (isDeleted)
                {
                    CodeNameList.Remove(codes);
                }
                else
                {
                }
            }
        }
        else
        {
            CodeNameList.Remove(CodeNameList.Find(x => x.DiagnosticCodeName == codes.DiagnosticCodeName));
        }
    }

