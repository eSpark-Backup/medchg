    public async Task OpenModal(bool opt)
    {
        ModalDisplay = "block;";
        await Task.Delay(100);
        if (opt)
        {
            ModalOpt = true;
        }
        else
        {
            ModalOpt = false;
        }
        ModalClass = "show";
        ShowBackdrop = true;
        StateHasChanged();
    }
    public async Task CloseModal()
    {
        ModalClass = "";
        await Task.Delay(250);
        ModalDisplay = "none";
        ShowBackdrop = false;
        StateHasChanged();
    }
