@page "/Account/register2"
@using static MEDCHGWEB.Components.Pages.Admin.ViewAdminUsers
@inject ILogger<RegisterAdminUser> Logger

<div class="modal fade @Class" tabindex="-1" role="dialog" style="display:@Display" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="z-index:1055">
        <div class="modal-content" style="background-color:#E9EAF7">
            <div class="modal-header justify-content-center bg-white">
                <h1 class="modal-title fs-5 col-11 text-center" id="AddAdmin">Admin Details</h1>
                <button type="button" class="btn-close col-1" @onclick="() => CloseModal()"></button>
            </div>
            <div class="modal-body bg-Indigo-20 row m-0 justify-content-center border-bottom rounded-3">
                <div class="col-8">
                    <EditForm Model="@Model" OnValidSubmit="()=>CallSaveAdmin()" FormName="Starship1">
                        <DataAnnotationsValidator />
                        <div class="mt-1 mb-2 row justify-content-center text-center">
                            @if (!string.IsNullOrEmpty(errorMessage))
                            {
                                <p style="color: red;">@errorMessage</p>
                            }
                        </div>
                        <div class="row">
                            <h6 class="mt-1 ps-0">User Name:</h6>
                        </div>
                        <div class="row">
                            <InputText @bind-Value="Model.Users.UserName" class="form-control" autocomplete="username" aria-required="true" placeholder="MED John Smith" />
                            <ValidationMessage For="() => Model.Users.UserName" class="text-danger" />
                        </div>
                        <div class="row mt-2">
                            <h6 class="mt-2 ps-0">Name:</h6>
                        </div>
                        <div class="row">
                            <InputText @bind-Value="Model.Users.FullName" class="form-control" autocomplete="name" aria-required="true" placeholder="Jhon Smith" />
                            <ValidationMessage For="() => Model.Users.FullName" class="text-danger" />
                        </div>
                        <div class="row mt-2">
                            <h6 class="mt-2 ps-0">Email:<span class="text-danger"> *</span></h6>
                        </div>
                        <div class="row">
                            <InputText @bind-Value="Model.Users.Email" class="form-control" autocomplete="name" aria-required="true" placeholder="Smith@example.com" />
                            <ValidationMessage For="() => Model.Users.Email" class="text-danger" />
                        </div>
                        <div class="row mt-2">
                            <h6 class="mt-2 ps-0">Password:</h6>
                        </div>
                        <div class="row">
                            <InputText type="password" @bind-Value="Model.Password" class="form-control specialAllow" autocomplete="username" aria-required="true" placeholder="MED John Smith" />
                            <ValidationMessage For="() => Model.Password" class="text-danger" />
                        </div>
                        <div class="row mt-2">
                            <h6 class="mt-2 ps-0">Confirm Password:</h6>
                        </div>
                        <div class="row">
                            <InputText type="password" @bind-Value="Model.ConfirmPassword" class="form-control specialAllow" autocomplete="new-password" aria-required="true" placeholder="password" />
                            <ValidationMessage For="() => Model.ConfirmPassword" class="text-danger" />
                        </div>
                        <div class="row mt-2">
                            <h6 class="mt-2 ps-0">Role:</h6>
                        </div>
                        <div class="row">
                            <InputSelect class="form-select" @bind-Value="@Model.Users.UserRole">
                                <option selected value="">Select User Role</option>
                                <option value="Editor Access">Editor Access</option>
                                <option value="Operator Access">Operator Access</option>
                            </InputSelect>
                        </div>
                        <br />
                        <div class="row mt-2">
                            <button type="submit" class="btn btn-primary form-control mb-2">Create Admin</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
    @if (Backdrop)
    {
        <div class="modal-backdrop fade show" data-dismiss="modal" @onclick="() => CloseModal()"></div>
    }
</div>
@code {
    public string Display { get; set; }
    public string Class { get; set; }
    public bool Backdrop { get; set; }
    [Parameter]
    public AdminUsers? Model { get; set; }
    [Parameter]
    public List<AdminUsers>? CheckList { get; set; }

    public string errorMessage = null;
    [Parameter]
    public EventCallback<bool> OnCloseModal { get; set; }

    [Parameter]
    public EventCallback<Room> OnSaveConfirmed { get; set; }

    List<string> items = new List<string> { "Editor Access", "Operator Access" };

    protected override void OnInitialized()
    {
        Model = new();
    }

    async Task CallSaveAdmin()
    {
        var check = CheckList.Where(x => x.Users.UserName == Model.Users.UserName && x.Users.Email == Model.Users.Email).FirstOrDefault();
        if (check is null)
        {
            if (!string.IsNullOrEmpty(Model.Users.UserName) && !string.IsNullOrEmpty(Model.Users.Email))
            {
                await OnSaveConfirmed.InvokeAsync();
                await CloseModal();
            }
            else
            {
                errorMessage = "Please enter the required field.";
            }
        }
        else
        {
            errorMessage = "This Username or Email is already taken.";
        }
    }

    public async Task OpenModal(bool opt)
    {
        errorMessage = "";
        Display = "block;";
        await Task.Delay(250);
        Class = "show";
        Backdrop = true;
        StateHasChanged();
    }
    public async Task CloseModal()
    {
        errorMessage = "";
        Class = "";
        await Task.Delay(250);
        Display = "none";
        Backdrop = false;
        await OnCloseModal.InvokeAsync();
        StateHasChanged();
    }
    public class AdminUsers
    {
        [Required]
        [StringLength(100, ErrorMessage = "The {0} must be at least {2} and at max {1} characters long.", MinimumLength = 6)]
        [DataType(DataType.Password)]
        public string? Password { get; set; } = "";

        [DataType(DataType.Password)]
        [Compare("Password", ErrorMessage = "The password and confirmation password do not match.")]
        public string? ConfirmPassword { get; set; } = "";

        public User? Users { get; set; } = new();
    }

}
