    {
        if (editUserId != null)
        {
            if (UserModelDTOPassword.Password != UserModelDTOPassword.ConfirmPassword)
            {
                UpdatePwdErrorMessage = $"Error: The new password and confirmation password do not match.";
                await CloseModal();
                return;
            }
            AspUser = await UserManager.FindByIdAsync(currentUser.UserId);
            hasPassword = await UserManager.HasPasswordAsync(AspUser);
            var changePasswordResult = await UserManager.ChangePasswordAsync(AspUser, UserModelDTOPassword.OldPassword, UserModelDTOPassword.Password);
            if (!changePasswordResult.Succeeded)
            {
                UpdatePwdErrorMessage = $"Error: {string.Join(",", changePasswordResult.Errors.Select(error => error.Description))}";
