        {
            await CloseModal();
            UpdatePwdErrorMessage = "Confirm Password Must be match with new password.";
        }

    }
    async Task<bool> ValidatePassword()
    {
        UpdatePwdErrorMessage = "";
        var validate = false;
        AspUser = await UserManager.FindByIdAsync(currentUser.UserId);
        bool isPasswordValid = await UserManager.CheckPasswordAsync(AspUser, UserModelDTOPassword.OldPassword);
        if (string.IsNullOrWhiteSpace(UserModelDTOPassword.OldPassword))
        {
            UpdatePwdErrorMessage = $"Error: Please enter current password.";
            validate = true;
        }
        else if (string.IsNullOrWhiteSpace(UserModelDTOPassword.Password))
        {
            UpdatePwdErrorMessage = $"Error: Please enter new password.";
            validate = true;
        }
        else if (string.IsNullOrWhiteSpace(UserModelDTOPassword.ConfirmPassword))
        {
            UpdatePwdErrorMessage = $"Error: Please enter confirm new password.";
            validate = true;
        }
        else if (!isPasswordValid)
        {   
            UpdatePwdErrorMessage = $"Error: Incorrect current password.";
            validate = true;
        }
        else if (UserModelDTOPassword.Password != UserModelDTOPassword.ConfirmPassword)
        {
            UpdatePwdErrorMessage = $"Error: The new password and confirmation password do not match.";
            validate = true;
        }
        return validate;
    }
