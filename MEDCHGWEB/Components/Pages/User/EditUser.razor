    private async Task GetItems()
    {
        var ChargeCodesresponse = await httpclient.GetFromJsonAsync<List<ChargeCode>>($"api/Provider/GetAllChargeCodesByProviderId{ProviderId}");
        var UsersChargeCodesresponse = await httpclient.GetFromJsonAsync<List<UsersChargeCode>>($"api/User/GetUsersChargeCodeById{id}");
        allChargeCodes.AddRange(ChargeCodesresponse.Select(x => new ChargeCode
            {
                ChargeCodeName = x.ChargeCodeName,
                ChargeCodeDescription = x.ChargeCodeDescription,
                Id = x.Id,
                IsFavourite = x.IsFavourite,
            }));
        // Create a dictionary to map ChargeCode Id to IsFavourite
        var chargeCodeFavourites = UsersChargeCodesresponse.ToDictionary(x => x.Id, x => x.IsFavourite);
        // Update allChargeCodes based on the dictionary
        foreach (var chargeCode in allChargeCodes)
        {
            if (chargeCodeFavourites.TryGetValue(chargeCode.Id, out bool isFavourite))
            {
                chargeCode.IsFavourite = isFavourite;
            }
        }
        var DiagnosticCodesresponse = await httpclient.GetFromJsonAsync<List<DiagnosticCode>>($"api/Provider/GetAllDiagnosticCodesByProviderId{ProviderId}");
        var UsersDiagnosticCodesresponse = await httpclient.GetFromJsonAsync<List<UsersDiagnosticCode>>($"api/User/GetUsersDiagnosticCodeById{id}");
        allDiagnosticCodes.AddRange(DiagnosticCodesresponse.Select(x => new DiagnosticCode
            {
                DiagnosticCodeName = x.DiagnosticCodeName,
                DiagnosticCodeDescription = x.DiagnosticCodeDescription,
                Id = x.Id,
                IsFavourite = x.IsFavourite,
            }));
        // Create a dictionary to map DiagnosticCode Id to IsFavourite
        var diagnosticCodeFavourites = UsersDiagnosticCodesresponse.ToDictionary(x => x.DiagnosticCodeId, x => x.IsFavourite);

        // Update allDiagnosticCodes based on the dictionary
        foreach (var diagnosticCode in allDiagnosticCodes)
        {
            if (diagnosticCodeFavourites.TryGetValue(diagnosticCode.Id, out bool isFavourite))
            {
                diagnosticCode.IsFavourite = isFavourite;
            }
        }
        var Hospitalresponse = await httpclient.GetFromJsonAsync<List<Hospital>>($"api/Provider/GetAllHospitalsByProviderId{ProviderId}");
        var UsersHospitalresponse = await httpclient.GetFromJsonAsync<List<UsersHospital>>($"api/User/GetUsersHospitalById{id}");
        allHospitals.AddRange(Hospitalresponse.Select(x => new Hospital
            {
                HospitalName = x.HospitalName,
                Id = x.Id,
                IsFavourite = x.IsFavourite,
            }));
        // Create a dictionary to map HospitalId to IsFavourite
        var hospitalFavourites = UsersHospitalresponse.ToDictionary(x => x.HospitalId, x => x.IsFavourite);

        // Update allHospitals based on the dictionary
        foreach (var hospital in allHospitals)
        {
            if (hospitalFavourites.TryGetValue(hospital.Id, out bool isFavourite))
            {
                hospital.IsFavourite = isFavourite;
            }
        }
    }
