                </thead>
                <tbody style="vertical-align:initial !important;">
                    @foreach (HospitalListItemVm? item in displayedItems.OrderByDescending(x => x!.Status == true))
                    {
                        <tr>
                            <td scope="row" class="blue60">@item!.Id</td>
                            <td style="cursor:pointer" @onclick="(() => NavigateToDashboard(item.Id!.Value))" class="blue70">@item.Name</td>
                            <td class="blue60">@item.PatientVisitCount</td>
                            <td>
                                @if (item.Status == true)
                                {
                                    <img src="images/fillcapsule.png" width="25" @onclick="() => FavHospital(item.Id!.Value, false)" />
                                }
                                else
                                {
                                    <img src="images/capsule.png" width="25" @onclick="() => FavHospital(item.Id!.Value, true)" />
                                }
                            </td>
                            <td>
                                <button type="button" name="Add patient" @onclick="(() => NavigateTo(item.Id!.Value))" class="btn btn-primary btn-sm">
                                    <span>Add patient&nbsp;&nbsp;</span>
                                    <i class="fa fa-user-md"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="responsive-hospitalpatient-div p-0">
            @foreach (HospitalListItemVm? item in displayedItems.OrderByDescending(x => x!.Status == true))
            {
                <div class="col-sm-12 border border-3 rounded-top border-bottom-0 p-3">
                    <div class="row text-start">
                        <div class="col-10">
                            <h4 @onclick="(() => NavigateToDashboard(item.Id!.Value))">
                                @item.Name
                            </h4>
                        </div>
                        <div class="col-2">
                            @if (item.Status == true)
                            {
                                <img src="images/fillcapsule.png" @onclick="() => FavHospital(item.Id!.Value, false)" />
                            }
                            else
                            {
                                <img src="images/capsule.png" @onclick="() => FavHospital(item.Id!.Value, true)" />
                            }
                        </div>
                    </div>
                    <div class="row text-start">
                        <div class="col-12">
                            <h5 @onclick="(() => NavigateToDashboard(item.Id!.Value))">
                                Hospital ID: <span class="h3">@item!.Id</span>
                            </h5>
                        </div>
                        <div class="col-12" @onclick="(() => NavigateToDashboard(item.Id!.Value))">
                            <h5>
                                Patients to Visit: <span class="h3">@item.PatientVisitCount</span>
                            </h5>
                        </div>
                    </div>
                </div>
                <div class="border border-3 border-top-0 rounded-bottom p-0 mb-3">
                    <button class="btn btn-primary w-100 rounded-bottom-1 rounded-top-0" @onclick="(() => NavigateTo(item.Id!.Value))">
                        Add Patient
