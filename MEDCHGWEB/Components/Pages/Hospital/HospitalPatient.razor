@code {
    List<Response?>? Model;
    private List<HospitalListItemVm> displayedItems = new();
    private List<HospitalListItemVm> HospitalLists = new();
    string? searchText;
    string? ProviderName;
    private int sortedColumn = -1;
    private bool isAscending = true;
    int startIndex = 0;
    int itemsPerPage = 5; // Number of items per page
    int currentPage = 1; // Current page
    int totalPages; // Total number of pages
    private CurrentUserModel? currentUser;
    private HospitalListVm? Hospital = new();
    private bool isInitialized = false;
    protected override async Task OnInitializedAsync()
    {
        if (!isInitialized)
        {
            isInitialized = true;
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity!.IsAuthenticated)
            {
                currentUser = user.GetUserInfo();
            }
            string pId = currentUser!.ProviderId!;
            if (Model == null)
            {
                Model = new List<Response?>();
            }

            var resp = await httpclient.GetFromJsonAsync<HospitalListVm>($"api/Hospital/HospitalWithProvider?pid={pId}&uid={currentUser.Id}");
            HospitalLists = resp.Items;
            if (resp != null)
            {
                ProviderName = resp.ProviderName;

                displayedItems = resp.Items.Skip(startIndex).Take(itemsPerPage).ToList();
                totalPages = (int)Math.Ceiling((double)resp.Items.Count / itemsPerPage);

                StateHasChanged();
            }
        }

    }

    public void NavigateTo(int id)
    {
        Navigation.NavigateTo($"/PatientRegistration?id={id}");
    }

    public async Task NavigateToDashboard(int HospId)
    {
        await sessionStorage.SetItemAsync("HospitalId", HospId);
        Navigation.NavigateTo($"/BuildingPatient/{HospId}");

    }

    private void Sort(int num)
    {
        if (sortedColumn == num)
        {
            isAscending = !isAscending;
        }
        else
        {
            sortedColumn = num;
            isAscending = true;
        }
        switch (num)
        {
            case 0:
                displayedItems = isAscending ? displayedItems.OrderBy(x => x.Name).ToList() : displayedItems.OrderByDescending(x => x.Name).ToList();
                break;
            case 1:
                displayedItems = isAscending ? displayedItems.OrderBy(x => x.PatientVisitCount).ToList() : displayedItems.OrderByDescending(x => x.PatientVisitCount).ToList();
                break;

            default:
                break;
        }
        StateHasChanged();
    }

    void DisplayItems()
    {
        startIndex = (currentPage - 1) * itemsPerPage;
        displayedItems = HospitalLists.Skip(startIndex).Take(itemsPerPage).ToList();
    }

    void PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
            DisplayItems();
        }
    }

    void NextPage()
    {
        if (currentPage < totalPages)
        {
            currentPage++;
            DisplayItems();
        }
    }
    private async Task FavHospital(int id, bool fav)
    {
        var userhospital = new UsersHospital
            {
                UserId = Convert.ToInt32(currentUser!.Id),
                IsFavourite = fav,
                HospitalId = id,
                UpdatedAt = TimeHelper.GetTexasTime(),
                UpdatedById = Convert.ToInt32(currentUser.Id)
            };
        var Hospitalresponse = await httpclient.PutAsJsonAsync($"api/User/Update-UsersHospital", userhospital);
        if (Hospitalresponse.IsSuccessStatusCode)
        {
            // Update the HospitalLists
            var resp = await httpclient.GetFromJsonAsync<HospitalListVm>($"api/Hospital/HospitalWithProvider?pid={currentUser!.ProviderId!}&uid={currentUser.Id}");
            HospitalLists = resp.Items;

            // Update the displayedItems
            displayedItems = HospitalLists.Skip(0).Take(itemsPerPage).ToList();

            // Update the currentPage
            currentPage = 1;

            // Re-render the page
            StateHasChanged();
        }
        else
        {
            // Handle error
        }
    }

    void ChangePage(int page)
    {
        currentPage = page;
        DisplayItems();
    }

    private async void UpdateSearchText(ChangeEventArgs e)
    {
        searchText = e.Value!.ToString()!.ToLower();
        // Check if the backspace key is pressed
        if (string.IsNullOrEmpty(searchText))
        {
            displayedItems.Clear(); // Clear the search results
            DisplayItems();
            return;
        }
        // Search the entire HospitalLists
        displayedItems = HospitalLists
        .Where(x => x.Name!.ToLower().Contains(searchText) ||
        x.Id!.ToString().ToLower().Contains(searchText) ||
        x.PatientVisitCount!.ToString().ToLower().Contains(searchText))
        .Skip(startIndex)
        .Take(itemsPerPage)
        .ToList();
        StateHasChanged();
    }

    public class Response
    {
        public int id { get; set; }
        public string? HospitalName { get; set; }
        public string? Name { get; set; }
        public string? DisplayName { get; set; }
        public int PatCount { get; set; }
        public bool Status { get; set; }
    }

}
