@page "/HospitalPatient"
@rendermode InteractiveServer
@using MEDCHGClassLibrary.ViewModels.Hospital
@using System.Text.Json.Serialization;
@attribute [Authorize]
@layout WithoutBackButton

<br />
<br />
<br />
<div class="container">
