@using Microsoft.AspNetCore.WebUtilities
@inject NavigationManager NavManager;

<div class="modal fade @Class" tabindex="-1" role="dialog" style="display:@Display" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="z-index:1055">
        <div class="modal-content" style="background-color:#E9EAF7">
            <div class="modal-header justify-content-center bg-white">
                <h1 class="modal-title fs-5 col-11 text-center" id="AddBuilding">Edit Floor Details</h1>
                <button type="button" class="btn-close col-1" @onclick="() => CloseModal()"></button>
            </div>
            <div class="modal-body bg-Indigo-20 row m-0 justify-content-center border-bottom rounded-3">
                <div class="col-8">
                    <EditForm id="myForm" OnValidSubmit="() => SaveItem()" Model="@Floor" FormName="EditFloor">
                        <DataAnnotationsValidator />
                        <div class="row">
                            <h5 class="mt-1 ps-0">Floor Name:</h5>
                        </div>
                        <div class="row">
                            <InputText id="BName" @bind-Value="Floor.Name" class="form-control" style="padding-left: 25px;" placeholder="Building 1" />
                            <ValidationMessage For="() => Floor.Name" class="text-danger" />
                        </div>
                        <div class="row mt-2">
                            <h5 class="mt-2 ps-0">Room Code:</h5>
                        </div>
                        <div class="row">
                            <InputText id="BLocation" @bind-Value="Floor.RoomCode" class="form-control" style="padding-left: 25px;" placeholder="Enter location" />
                            <ValidationMessage For="() => Floor.RoomCode" class="text-danger" />
                        </div>
                        <div class="row mt-2">
                            <h5 class="mt-2 ps-0">Room Range:<span class="text-danger"> *</span></h5>
                        </div>
                        <div class="row">
                            <div class="col-6 ps-0">
                                <InputNumber id="BFloor" @bind-Value="Floor.RoomRange1" class="form-control" style="padding-left: 25px;" placeholder="01" />
                                <ValidationMessage For="() => Floor.RoomRange1" class="text-danger" />
                            </div>
                            <div class="col-6">
                                <InputNumber id="BFloor" @bind-Value="Floor.RoomRange2" class="form-control" style="padding-left: 25px;" placeholder="01" />
                                <ValidationMessage For="() => Floor.RoomRange2" class="text-danger" />
                            </div>
                        </div>
                        <br />
                        <div class="row mt-2">
                            <button type="submit" class="btn btn-primary form-control mb-3" >Save Details</button>
                        </div>
                        <h6 class="text-danger text-center">@ErrorMessage</h6>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
    @if (Backdrop)
    {
        <div class="modal-backdrop fade show" data-dismiss="modal" @onclick="() => CloseModal()"></div>
    }
</div>

@code {

    [Parameter]
    public Floor? Floor { get; set; }

    public string Display { get; set; }
    public string Class { get; set; }
    public bool Backdrop { get; set; }
    [Parameter]
    public EventCallback<bool> OnCloseModal { get; set; }
    [Parameter]
    public EventCallback<Room> OnSaveConfirmed { get; set; }

    public string ErrorMessage { get; set; }

    protected async override void OnInitialized()
    {
        if (Floor == null)
        {
            try
            {
                Floor = new Floor();
            }
            catch (Exception ex)
            {

            }
        }

    }
    private bool isSaving = false;
    private async Task SaveItem()
    {
        if (Floor.RoomCode is not "" && Floor.RoomCode is not null)
        {
                if (Floor.RoomRange1 > 0 && Floor.RoomRange1 <= Floor.RoomRange2)
            {
                ErrorMessage = "";
                await OnSaveConfirmed.InvokeAsync();
                await CloseModal();
            }
            else
            {
                ErrorMessage = "Please Enter Greater Than 0 in 1st Range and less than Second Range!";
            }
        }
        else
        {
            ErrorMessage = "Please Enter Missing Feild";
        }
    }
    public async Task OpenModal(bool opt)
    {
        Display = "block;";
        await Task.Delay(100);
        Class = "show";
        Backdrop = true;
        StateHasChanged();
    }
    public async Task CloseModal()
    {
        ErrorMessage = "";
        Class = "";
        await Task.Delay(250);
        Display = "none";
        Backdrop = false;
        await OnCloseModal.InvokeAsync();
        StateHasChanged();
    }

}
